---
import type { GetStaticPaths } from 'astro';
import type { Cell } from '../../data/grid-types';
import Layout from '../../layouts/Layout.astro';
import Tavolo from '../../components/tavolo/Tavolo.astro';
import Foglio from '../../components/foglio/Foglio.astro';
import { tavolo } from '../../data/tavolo';
import { projects } from '../../data/projects';
import { projectsByYear } from '../../lib/projects';
import { scaleShape } from '../../lib/grid';
import { pageTitle } from '../../data/site';

export const getStaticPaths = (() =>
  projects.map(p => ({ params: { slug: p.slug }, props: { project: p } }))
) satisfies GetStaticPaths;

const { project: p } = Astro.props;

// hero = forma del progetto ×1, come in archivio: cresce solo di quanto il quadretto del foglio è più grande di
// quello del tavolo; senza forma, quadrato come in archivio.
// Celle informative in moduli da 2 e 4 colonne: si incastrano accanto a qualsiasi hero.
// se il marchio non è mio, lo dico in chiaro sotto la descrizione
const marchio = p.marchio === 'cliente' ? 'Marchio esistente, del cliente.' : typeof p.marchio === 'object' ? `Marchio di ${p.marchio.di}.` : '';
const heroSpan = p.shape ? scaleShape(p.shape, 1) : p.featured ? { w: 4, h: 4 } : { w: 2, h: 2 };

// progetto precedente e successivo nell'ordine dell'archivio (dal più recente), in giro: dopo l'ultimo il primo
const at = projectsByYear.findIndex(x => x.slug === p.slug);
const sibling = (step: number) => projectsByYear[(at + step + projectsByYear.length) % projectsByYear.length];
const siblingCell = (id: string, label: string, step: number): Cell => {
  const s = sibling(step);
  return { id, type: 'text', w: 4, h: 1, size: 's', as: 'p', href: `/progetti/${s.slug}`, replace: true, eyebrow: `Progetto ${label}`, title: s.title };
};

const cells: Cell[] = [
  { id: 'hero', type: 'media', ...heroSpan, heroOf: `/progetti/${p.slug}`, image: p.image, video: p.video, alt: `${p.title} · ${p.description}` },
  { id: 'progetto', type: 'text', w: 4, h: 2, as: 'h1', size: 's', eyebrow: 'Progetto', title: p.title, body: [p.description, marchio].filter(Boolean).join(' ') },
  { id: 'indietro', type: 'text', w: 2, h: 2, tone: 'red', href: '/', as: 'p', size: 'm', eyebrow: 'Chiudi', title: 'Indice' },
  // celle proprie del progetto (cells in index.md); finché non ci sono, il segnaposto
  ...(p.cells ?? [{ id: 'nota', type: 'text', w: 4, h: 2, size: 's', title: 'Contenuto segnaposto: qui andranno immagini, processo e risultati.' }]),
  siblingCell('prec', 'precedente', -1),
  siblingCell('succ', 'successivo', 1),
];
---

<Layout foglio titolo={pageTitle(p.title)} descrizione={p.description}>
  <Tavolo cells={tavolo} sotto />
  <Foglio cells={cells} />
</Layout>
