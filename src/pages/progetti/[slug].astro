---
import type { GetStaticPaths } from 'astro';
import type { Cell } from '../../data/grid-types';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import MediaCell from '../../components/cells/MediaCell.astro';
import Grid from '../../components/Grid.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { projects } from '../../data/projects';
import { tagSlug } from '../../lib/tags';

export const getStaticPaths = (() =>
  projects.map(p => ({ params: { slug: p.slug }, props: { project: p } }))
) satisfies GetStaticPaths;

const { project: p } = Astro.props;
const year = p.period.match(/\d{4}/)?.[0] ?? '—';

const cells: Cell[] = [
  { id: 'progetto', type: 'text', w: 3, h: 1, as: 'h1', size: 's', eyebrow: 'Progetto', title: p.title, body: p.description, titleOf: `/progetti/${p.slug}` },
  { id: 'tag', type: 'list', w: 2, h: 1, title: 'Tag', items: p.tags.map(t => ({ label: t, href: `/archivio?tag=${tagSlug(t)}` })) },
  { id: 'anno', type: 'stat', w: 1, h: 1, value: year, caption: p.period },
  { id: 'indietro', type: 'text', w: 1, h: 1, tone: 'red', href: '/', as: 'p', size: 'm', eyebrow: 'Torna a', title: 'Indice' },
  { id: 'registro', type: 'mark', w: 1, h: 1 },
  { id: 'nota', type: 'text', w: 4, h: 1, size: 's', eyebrow: 'Nota', title: 'Contenuto segnaposto: qui andranno immagini, processo e risultati.' },
];
---

<Layout titolo={`${p.title} — Roberto`} descrizione={p.description}>
  <main id="main" class="sheet">
    <PageHero from={`/progetti/${p.slug}`} label={p.slug}>
      <MediaCell image={p.image} video={p.video} alt={`${p.title} — ${p.description}`} sizes="100vw" />
    </PageHero>
    <Grid cells={cells} />
    <SiteFooter />
  </main>
</Layout>
