---
import type { GetStaticPaths } from 'astro';
import type { Cell } from '../../data/grid-types';
import Layout from '../../layouts/Layout.astro';
import Tavolo from '../../components/tavolo/Tavolo.astro';
import Foglio from '../../components/foglio/Foglio.astro';
import { tavolo } from '../../data/tavolo';
import { projects } from '../../data/projects';
import { projectsByYear } from '../../lib/projects';
import { scaleShape } from '../../lib/grid';
import { pageTitle } from '../../data/site';
import { senzaSegni } from '../../lib/format';

export const getStaticPaths = (() =>
  projects.map(p => ({ params: { slug: p.slug }, props: { project: p } }))
) satisfies GetStaticPaths;

const { project: p } = Astro.props;

// hero = forma del progetto ×2 (31/10/2026, scelta di Roberto: più grande, in proporzione; ×1,5 darebbe mezze unità);
// tutta larghezza con lo stesso rapporto se non ci sta. Senza forma, il quadrato dell'archivio ×2.
// Celle informative in moduli da 2 e 4 colonne: si incastrano accanto a qualsiasi hero.
// se il marchio non è mio, lo dico in chiaro sotto la descrizione
const marchio = p.marchio === 'cliente' ? 'Marchio esistente, del cliente.' : typeof p.marchio === 'object' ? `Marchio di ${p.marchio.di}.` : '';
const descrizione = [p.description, marchio].filter(Boolean).join(' ');
const heroSpan = scaleShape(p.shape ?? (p.featured ? { w: 4, h: 4 } : { w: 2, h: 2 }), 2);

// progetto precedente e successivo nell'ordine dell'archivio (dal più recente), in giro: dopo l'ultimo il primo
const at = projectsByYear.findIndex(x => x.slug === p.slug);
const sibling = (step: number) => projectsByYear[(at + step + projectsByYear.length) % projectsByYear.length];
const siblingCell = (id: string, label: string, step: number): Cell => {
  const s = sibling(step);
  return { id, type: 'text', w: 4, h: 1, size: 's', as: 'p', href: `/progetti/${s.slug}`, replace: true, coda: true, eyebrow: `Progetto ${label}`, title: s.title };
};

const cells: Cell[] = [
  { id: 'hero', type: 'media', ...heroSpan, heroOf: `/progetti/${p.slug}`, image: p.image, video: p.video, alt: `${p.title} · ${senzaSegni(p.description)}` },
  // con la foto di contesto la cella si allunga: il testo e, sotto, la foto
  p.contesto
    ? { id: 'progetto', type: 'contesto', w: 4, h: 7, eyebrow: 'Contesto', title: p.title, body: descrizione, image: p.contesto.foto, alt: p.contesto.alt }
    : { id: 'progetto', type: 'text', w: 4, h: 2, as: 'h1', size: 's', eyebrow: 'Progetto', title: p.title, body: descrizione },
  // celle proprie del progetto (cells in index.md); finché non ci sono, il segnaposto
  ...(p.cells ?? [{ id: 'nota', type: 'text', w: 4, h: 2, size: 's', title: 'Contenuto segnaposto: qui andranno immagini, processo e risultati.' }]),
  siblingCell('prec', 'precedente', -1),
  siblingCell('succ', 'successivo', 1),
];
---

<Layout foglio titolo={pageTitle(p.title)} descrizione={senzaSegni(p.description)}>
  <Tavolo cells={tavolo} sotto />
  <Foglio cells={cells} centrato />
</Layout>
