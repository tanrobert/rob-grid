---
import type { Cell } from '../data/grid-types';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Grid from '../components/Grid.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SvgAsset from '../components/SvgAsset.astro';

// Testi segnaposto: da sostituire con la bio vera.
const cells: Cell[] = [
  {
    id: 'bio', type: 'text', w: 4, h: 2, as: 'p', size: 'l',
    eyebrow: 'Bio',
    title: 'Disegno sistemi visivi: marchi, confezioni, siti. Parto da una griglia e da poche regole, poi le applico con rigore.',
  },
  { id: 'logo', type: 'svg', w: 2, h: 2, svg: 'logo-r' },
  { id: 'settori', type: 'list', w: 3, h: 1, title: 'Settori', items: ['Ristorazione', 'Ospitalità', 'Cultura', 'Salute', 'Consulenza', 'Imprese'] },
  { id: 'ora', type: 'clock', w: 1, h: 1 },
  { id: 'indietro', type: 'text', w: 2, h: 1, tone: 'red', href: '/', as: 'p', size: 'm', eyebrow: 'Torna a', title: 'Indice' },
];
---

<Layout titolo="Info — Roberto" descrizione="Chi sono: Roberto, graphic designer. Identità visive, packaging e siti web per ristorazione, ospitalità, cultura e imprese.">
  <main id="main" class="sheet">
    <PageHero from="/info" label="info" tone="red">
      <div class="info-hero">
        <p class="mono">Chi sono</p>
        <h1>Info</h1>
        <SvgAsset name="roberto" class="info-hero__name" />
      </div>
    </PageHero>
    <Grid cells={cells} />
    <SiteFooter />
  </main>
</Layout>

<style>
  .info-hero {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; justify-content: flex-end; gap: var(--pad);
    padding: var(--pad-label) var(--pad) var(--pad);
  }
  .info-hero .mono { margin-bottom: auto; }
  h1 {
    font-size: min(26cqi, 44cqb);
    line-height: 0.76;
    letter-spacing: -0.06em;
    margin-left: -0.05em;
  }
  .info-hero :global(.info-hero__name) { width: 100%; height: auto; }
</style>
