---
import '../styles/global.css';
import { site, homeTitle } from '../data/site';

interface Props {
  titolo?: string;
  descrizione?: string;
  /** false sulle pagine che non devono indicare un indirizzo canonico (404) */
  canonical?: boolean;
  /** la pagina è il tavolo (home): niente scroll, i gesti li fa scripts/tavolo */
  tavolo?: boolean;
  /** la pagina è il tavolo con un foglio aperto sopra (components/foglio): scorre il foglio */
  foglio?: boolean;
  /** pagina vera nel nuovo stile (components/foglio con `pagina`, oggi solo la 404): scorre la pagina */
  pagina?: boolean;
}

const {
  titolo = homeTitle,
  descrizione = `Identità visive, packaging e siti web. Portfolio di ${site.name}, graphic designer: progetti per ristorazione, ospitalità, cultura e imprese.`,
  canonical: withCanonical = true,
  tavolo = false,
  foglio = false,
  pagina = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="it" class:list={[tavolo && 'is-tavolo', foglio && 'ha-foglio', pagina && 'ha-pagina']}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f5f3f0" />
    <title>{titolo}</title>
    <meta name="description" content={descrizione} />
    {withCanonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/roberto-grafica-black.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        // js: il tavolo resta nascosto finché scripts/tavolo non l'ha disposto per la finestra vera
        root.classList.add('js');

        // Arrivo da una pagina del sito (click, non ricarica): niente intro. Su una pagina con foglio il foglio
        // entra dalla cella del tavolo che l'ha aperto (scripts/foglio): fino ad allora resta nascosto (in-arrivo)
        var nav = performance.getEntriesByType('navigation')[0];
        var tipo = nav ? nav.type : 'navigate';
        var interno = false;
        try { interno = tipo !== 'reload' && !!document.referrer && new URL(document.referrer).origin === location.origin; } catch (e) {}
        if (interno && root.classList.contains('ha-foglio')) root.classList.add('in-arrivo');
        if (!interno && tipo !== 'back_forward' && !matchMedia('(prefers-reduced-motion: reduce)').matches) root.classList.add('is-intro');

        // --dp = 1 pixel reale dello schermo in px CSS (Windows al 125% → 0.8px).
        // Serve alle linee disegnate con i gradienti, che il browser non aggancia ai pixel. Si aggiorna con lo zoom
        function watch() {
          root.style.setProperty('--dp', 1 / devicePixelRatio + 'px');
          matchMedia('(resolution: ' + devicePixelRatio + 'dppx)').addEventListener('change', watch, { once: true });
        }
        watch();

        // colori invertiti con l'interruttore Inverti (scripts/ink.ts): prima del primo disegno, niente lampo di colori.
        // 'nero' è la scelta salvata dalla versione precedente dell'interruttore: vale come invertiti
        var scelta = null;
        try { scelta = localStorage.getItem('inchiostro'); } catch (e) {}
        if (scelta === 'bianco' || scelta === 'nero') root.dataset.inchiostro = 'bianco';
        // tinta nera di Woberto (scripts/ink.ts): solo per questa visita
        try { if (sessionStorage.getItem('tinta') === 'nero') root.dataset.tinta = 'nero'; } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Salta al contenuto principale</a>
    <div class="ruler" data-ruler aria-hidden="true">
      <div class="ruler__thumb" data-ruler-thumb><span class="ruler__pct" data-ruler-pct>000%</span></div>
    </div>
    <slot />
    <script is:inline>
      // intro: ogni cella inizia a disegnare il filo da un vertice a caso (0–3, orario dall'alto a sinistra)
      if (document.documentElement.classList.contains('is-intro')) {
        document.querySelectorAll('.cell').forEach(function (c) { c.dataset.from = Math.floor(Math.random() * 4); });
      }
    </script>
  </body>
</html>

<script>
  import '../scripts/ruler';
  import '../scripts/tavolo';
  import '../scripts/foglio';
  import { initCells } from '../scripts/cells';
  initCells();
</script>
