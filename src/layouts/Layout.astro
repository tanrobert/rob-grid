---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  titolo?: string;
  descrizione?: string;
}

const {
  titolo = 'Roberto — Graphic designer',
  descrizione = 'Identità visive, packaging e siti web. Portfolio di Roberto, graphic designer: progetti per ristorazione, ospitalità, cultura e imprese.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#e8e0e0" />
    <title>{titolo}</title>
    <meta name="description" content={descrizione} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/testo-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/numeri-400.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Intro solo al caricamento "vero": il ClientRouter non riesegue questo script nelle navigazioni -->
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('is-intro');

      // --dp = 1 pixel reale dello schermo in px CSS (Windows al 125% → 0.8px).
      // Serve alle linee disegnate con i gradienti, che il browser non aggancia ai pixel.
      // Si aggiorna con lo zoom e dopo ogni navigazione (lo swap riscrive gli attributi di <html>).
      (function () {
        var root = document.documentElement;
        function setDp() { root.style.setProperty('--dp', 1 / devicePixelRatio + 'px'); }
        function watch() {
          setDp();
          matchMedia('(resolution: ' + devicePixelRatio + 'dppx)').addEventListener('change', watch, { once: true });
        }
        watch();
        document.addEventListener('astro:after-swap', setDp);
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">Salta al contenuto principale</a>
    <div class="ruler" data-ruler aria-hidden="true" transition:persist="ruler">
      <div class="ruler__thumb" data-ruler-thumb><span class="ruler__pct" data-ruler-pct>000%</span></div>
    </div>
    <slot />
    <script is:inline>
      // intro: ogni casella inizia a disegnare il filo da un vertice a caso (0–3, orario dall'alto a sinistra)
      if (document.documentElement.classList.contains('is-intro')) {
        document.querySelectorAll('.cell').forEach(function (c) { c.dataset.from = Math.floor(Math.random() * 4); });
      }
    </script>
  </body>
</html>

<script>
  import '../scripts/morph';
  import '../scripts/ruler';
  import { initCells } from '../scripts/cells';
  document.addEventListener('astro:page-load', initCells);
</script>
