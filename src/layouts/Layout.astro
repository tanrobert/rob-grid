---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  titolo?: string;
  descrizione?: string;
  /** false sulle pagine che non devono indicare un indirizzo canonico (404) */
  canonical?: boolean;
  /** la pagina è il tavolo (home): niente scroll, i gesti li fa scripts/tavolo */
  tavolo?: boolean;
}

const {
  titolo = `${site.name} · Graphic designer`,
  descrizione = `Identità visive, packaging e siti web. Portfolio di ${site.name}, graphic designer: progetti per ristorazione, ospitalità, cultura e imprese.`,
  canonical: withCanonical = true,
  tavolo = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
// Nel <head>, il primo script inline fa partire l'intro solo al caricamento "vero":
// il ClientRouter non lo riesegue nelle navigazioni
---

<!doctype html>
<html lang="it" class:list={[tavolo && 'is-tavolo']}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f5f3f0" />
    <title>{titolo}</title>
    <meta name="description" content={descrizione} />
    {withCanonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/schibsted-grotesk.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/roberto-grafica-black.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // js: il tavolo resta nascosto finché scripts/tavolo non l'ha disposto per la finestra vera
      document.documentElement.classList.add('js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('is-intro');

      // --dp = 1 pixel reale dello schermo in px CSS (Windows al 125% → 0.8px).
      // Serve alle linee disegnate con i gradienti, che il browser non aggancia ai pixel.
      // Si aggiorna con lo zoom e dopo ogni navigazione (lo swap riscrive gli attributi di <html>).
      (function () {
        var root = document.documentElement;
        function setDp() { root.style.setProperty('--dp', 1 / devicePixelRatio + 'px'); }
        function watch() {
          setDp();
          matchMedia('(resolution: ' + devicePixelRatio + 'dppx)').addEventListener('change', watch, { once: true });
        }
        watch();
        document.addEventListener('astro:after-swap', setDp);

        // luce spenta con l'interruttore (scripts/ink.ts): prima del primo disegno, niente lampo di colori.
        // 'nero' è la scelta salvata dalla versione precedente dell'interruttore: vale come luce spenta
        function setInk() {
          var scelta = null;
          try { scelta = localStorage.getItem('inchiostro'); } catch (e) {}
          if (scelta === 'bianco' || scelta === 'nero') root.dataset.inchiostro = 'bianco';
        }
        setInk();
        document.addEventListener('astro:after-swap', setInk);

      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">Salta al contenuto principale</a>
    <div class="ruler" data-ruler aria-hidden="true" transition:persist="ruler">
      <div class="ruler__thumb" data-ruler-thumb><span class="ruler__pct" data-ruler-pct>000%</span></div>
    </div>
    <slot />
    <script is:inline>
      // intro: ogni casella (anche i vuoti e il footer) inizia a disegnare il filo da un vertice a caso (0–3, orario dall'alto a sinistra)
      if (document.documentElement.classList.contains('is-intro')) {
        document.querySelectorAll('.cell, .void, .foot').forEach(function (c) { c.dataset.from = Math.floor(Math.random() * 4); });
        // footer: altezza in unità (passo della griglia = --ruler-step) e turno dopo l'ultima cella
        var foot = document.querySelector('.foot');
        var step = parseFloat(getComputedStyle(document.body).getPropertyValue('--ruler-step'));
        if (foot && step) {
          foot.style.setProperty('--ch', String(Math.max(1, Math.round(foot.offsetHeight / step))));
          foot.style.setProperty('--i', String(document.querySelectorAll('.grid > .cell').length));
        }
      }
    </script>
  </body>
</html>

<script>
  import '../scripts/morph';
  import '../scripts/close';
  import '../scripts/ruler';
  import '../scripts/fill';
  import '../scripts/tavolo';
  import { initCells } from '../scripts/cells';
  document.addEventListener('astro:page-load', initCells);
</script>
