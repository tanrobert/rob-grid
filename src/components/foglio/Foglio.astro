---
// Foglio aperto sopra il tavolo (pagine info, extra, archivio, progetti): la griglia delle celle della pagina
// sugli stessi quadretti del tavolo (una cella di w unità è larga 4w − 1 quadretti, a un quadretto l'una
// dall'altra), sopra il retino che lascia intravedere il tavolo. Il foglio scorre con la pagina, il tavolo
// resta fermo dietro. Apertura e chiusura: scripts/foglio. In fondo i recapiti, come sul tavolo.
// Con `pagina` è una pagina vera (oggi solo la 404): niente tavolo né retino, il foglio sta sulla carta a quadretti
// e scripts/foglio non lo tocca (niente data-foglio).
import type { Cell } from '../../data/grid-types';
import Grid from '../Grid.astro';

interface Props {
  cells: Cell[];
  /** Archivio: i progetti ricevono data-tags per i filtri */
  filterable?: boolean;
  /** pagina vera, da usare con la prop `pagina` del Layout */
  pagina?: boolean;
  /** Pagine progetto: le colonne rimaste vuote a destra si chiudono e le celle stanno al centro del foglio */
  centrato?: boolean;
}
const { cells, filterable = false, pagina = false, centrato = false } = Astro.props;
const recapiti: Cell = { id: 'recapiti', type: 'contatti', w: 4, h: 2, tone: 'red', coda: true };
---

{!pagina && <div class="retino" data-retino aria-hidden="true"></div>}
<main id="main" class:list={['foglio', pagina && 'foglio--pagina', centrato && 'foglio--centrato']} data-foglio={pagina ? undefined : ''}>
  <slot />
  <Grid cells={[...cells, recapiti]} filterable={filterable} centrato={centrato} />
</main>

<style>
  /* quadretto del foglio: il più grande con cui le colonne minime della pagina (12, 8, 4) stanno nella finestra con
     un quadretto di margine per lato, ma da 600px in su mai più grande di quello del tavolo (Q.lg di lib/tavolo.ts, QF_MAX di lib/grid.ts per le foto):
     oltre, la finestra si riempie con colonne in più (il foglio è largo un numero intero di colonne, la griglia
     le conta da sola con auto-fill). Sul telefono restano 4 colonne a tutta larghezza.
     Passo della griglia = 4 quadretti: ci si allineano anche il righello e la ghiera della cella registro (--ruler-step) */
  :global(html:is(.ha-foglio, .ha-pagina) body) {
    --qf: round(down, min(100vw / (var(--cols) * 4 + 1), var(--qf-max)), 1px);
    --qf-max: 25px;
    --ruler-step: calc(var(--qf) * 4);
    /* i testi delle celle si misurano su questo quadretto (global.css) */
    --q-testo: var(--qf);
  }
  @media (max-width: 599px) { :global(html:is(.ha-foglio, .ha-pagina) body) { --qf-max: 100vw; } }
  /* pagine progetto (in prova dal 6/11/2026, scelta di Roberto): la composizione è fatta a mano, quindi sempre le
     colonne minime (12 computer, 8 tablet) e, sugli schermi larghi, il quadretto che cresce invece delle colonne in
     più: la stessa disposizione su ogni computer. Fino a QF_MAX_PROGETTI (lib/grid.ts, 28px: finestre da 1372px; 40 e 32 erano troppo grandi),
     oltre ai lati si vede il tavolo. Sul body (:has) perché il quadretto lo usano anche righello e testi; i fogli
     sotto nella pila sono hidden, quindi conta solo quello in cima */
  @media (min-width: 600px) {
    :global(html.ha-foglio body:has(.foglio--centrato:not([hidden]))) { --qf-max: 28px; }
    .foglio.foglio--centrato { --cols-max: var(--cols); }
  }
  /* telefono, fogli sopra il tavolo (1/11/2026, scelta di Roberto: più spazio alle celle): niente margini ai lati, le
     celle toccano i bordi dello schermo. Le 4 colonne riempiono la finestra (4·4−1 quadretti); gli spazi tra le celle,
     in verticale e tra due affiancate, restano di un quadretto. 1fr: i pixel che l'arrotondamento del quadretto
     lascia (meno di 15) si spartiscono tra le colonne, così la griglia arriva ai due bordi */
  @media (max-width: 599px) {
    :global(html.ha-foglio body) { --qf: round(down, 100vw / (var(--cols) * 4 - 1), 1px); }
    .foglio[data-foglio] { width: 100%; padding-inline: 0; }
    .foglio[data-foglio] :global(.grid) { grid-template-columns: repeat(var(--cols), 1fr); justify-content: normal; }
  }
  .foglio {
    --gap: var(--qf);
    --u: calc(var(--qf) * 3);
    position: relative;
    /* colonne in più fino a --cols-max (31/10/2026, prova di Roberto): oltre, ai lati si vede il tavolo */
    --cols-max: 16;
    width: calc(min(round(down, 100vw - var(--qf), var(--qf) * 4), var(--qf) * 4 * var(--cols-max)) + var(--qf));
    margin-inline: auto;
    padding: var(--qf);
  }
  /* sopra il tavolo la firma (components/Firma) resta ferma in alto a sinistra: sul computer a 25px dal bordo e alta
     25 (Q.lg di lib/tavolo.ts), sul telefono a un quadretto del foglio e alta 18 (Q.sm). Le celle partono sotto di
     lei, con un quadretto di carta in mezzo */
  .foglio[data-foglio] { padding-top: calc(25px * 2 + var(--qf)); }
  @media (max-width: 599px) { .foglio[data-foglio] { padding-top: calc(var(--qf) * 2 + 18px); } }

  /* colonne vuote chiuse (auto-fit) e quelle usate al centro: lo scarto è di mezze colonne, cioè quadretti interi.
     Non nell'archivio: filtrando le colonne usate cambiano e tutta la griglia si sposterebbe */
  .foglio--centrato :global(.grid) { grid-template-columns: repeat(auto-fit, var(--u)); justify-content: center; }

  /* pagina vera: la carta del tavolo (solo quadretti, crocini tolti il 6/11/2026) agganciata al foglio, che riempie
     almeno la finestra. La carta sborda ai lati di un numero intero di quadretti: le linee cadono sui bordi delle
     celle, senza calcoli sulla larghezza della finestra (lo scroll orizzontale lo taglia html) */
  .foglio--pagina { min-height: 100dvh; isolation: isolate; }
  .foglio--pagina::before {
    content: '';
    position: absolute; z-index: -1;
    top: 0; bottom: 0; left: calc(var(--qf) * -400); right: calc(var(--qf) * -400);
    pointer-events: none;
    --carta-ink: var(--carta-tinta);
    background-image:
      linear-gradient(to right, var(--carta-ink) var(--line-dp), transparent var(--line-dp)),
      linear-gradient(to bottom, var(--carta-ink) var(--line-dp), transparent var(--line-dp));
    background-size: var(--qf) var(--qf);
  }

  /* carta piena con un foro ogni 4px: si intravede il tavolo, ma senza mezze tinte (niente rosa) */
  .retino {
    position: fixed; inset: 0;
    background: var(--retino);
  }

  /* foglio chiuso: resta il tavolo (scripts/foglio) */
  :global(html.is-tavolo) :is(.foglio, .retino) { display: none; }
  /* arrivo da una cella del tavolo: foglio e retino aspettano l'apertura (scripts/foglio). Se il JavaScript non
     arriva compaiono lo stesso dopo un attimo */
  :global(html.in-arrivo) :is(.foglio, .retino) { visibility: hidden; animation: foglio-attesa 0s 1.5s both; }
  @keyframes foglio-attesa { to { visibility: visible; } }
</style>
