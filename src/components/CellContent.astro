---
// Una cella completa: il guscio (Cell.astro) col contenuto del suo tipo. Un solo modo di rendere
// le celle, usato dalla griglia delle pagine (Grid.astro) e dal tavolo della home (tavolo/Tavolo.astro)
import type { Cell as CellData } from '../data/grid-types';
import { getProject } from '../data/projects';
import { mediaSizes } from '../lib/grid';
import { tagSlug } from '../lib/tags';
import Cell from './Cell.astro';
import SvgCell from './cells/SvgCell.astro';
import LogotipoCell from './cells/LogotipoCell.astro';
import MarqueeCell from './cells/MarqueeCell.astro';
import TextCell from './cells/TextCell.astro';
import ListCell from './cells/ListCell.astro';
import StatCell from './cells/StatCell.astro';
import MediaCell from './cells/MediaCell.astro';
import ClockCell from './cells/ClockCell.astro';
import MeterCell from './cells/MeterCell.astro';
import CursorCell from './cells/CursorCell.astro';
import MarkCell from './cells/MarkCell.astro';
import EyeCell from './cells/EyeCell.astro';
import GlobeCell from './cells/GlobeCell.astro';
import BarattoloCell from './cells/BarattoloCell.astro';
import TelefonoCell from './cells/TelefonoCell.astro';
import PortatileCell from './cells/PortatileCell.astro';
import StickerCell from './cells/StickerCell.astro';
import AffissioneCell from './cells/AffissioneCell.astro';
import ContestoCell from './cells/ContestoCell.astro';
import SottologoCell from './cells/SottologoCell.astro';
import CostruzioneCell from './cells/CostruzioneCell.astro';
import RidisegnoCell from './cells/RidisegnoCell.astro';
import AnimatoCell from './cells/AnimatoCell.astro';
import EvoluzioneCell from './cells/EvoluzioneCell.astro';
import PaletteCell from './cells/PaletteCell.astro';
import SfumaturaCell from './cells/SfumaturaCell.astro';
import CopertineCell from './cells/CopertineCell.astro';
import VersioniCell from './cells/VersioniCell.astro';
import PuntiCell from './cells/PuntiCell.astro';
import CollezioniCell from './cells/CollezioniCell.astro';
import MarchioCell from './cells/MarchioCell.astro';
import GlifoCell from './cells/GlifoCell.astro';
import ProvaCell from './cells/ProvaCell.astro';
import AtlanteCell from './cells/AtlanteCell.astro';
import RadioCell from './cells/RadioCell.astro';
import ArchiveHeadCell from './cells/ArchiveHeadCell.astro';
import TagsCell from './cells/TagsCell.astro';
import ErrorCell from './cells/ErrorCell.astro';
import ContattiCell from './cells/ContattiCell.astro';

interface Props {
  cell: CellData;
  /** numero della linguetta: posizione nella lettura (sul tavolo, il numero del progetto) */
  index: number;
  /** Archivio: i progetti ricevono data-tags per i filtri */
  filterable?: boolean;
  /** foto caricata subito: la prima foto della pagina, quasi sempre l'elemento più grande in vista (LCP) */
  priority?: boolean;
  /** progetti nella stessa griglia: il totale della cella dei tag */
  projects?: number;
  /** turno nell'intro, se diverso da index (Cell.astro) */
  turno?: number;
  /** `sizes` delle foto, se non quello della griglia (sul tavolo: in px dai quadretti) */
  sizes?: string;
}
const { cell, index, filterable = false, priority = false, projects = 0, turno, sizes = mediaSizes(cell) } = Astro.props;

const p = cell.type === 'project' ? getProject(cell.slug) : undefined;
if (cell.type === 'project' && !p) throw new Error(`[grid] progetto non trovato: "${cell.slug}"`);
---

{cell.type === 'project' && p ? (
  <Cell
    cell={cell}
    index={index}
    turno={turno}
    href={cell.href ?? `/progetti/${p.slug}`}
    attrs={filterable ? { 'data-tags': p.tags.map(tagSlug).join(' ') } : undefined}
  >
    {/* alt vuoto: la cella è un link e la didascalia lo nomina già */}
    <MediaCell image={p.image} video={p.video} overlay={p.overlay} etichette={p.etichette} alt="" sizes={sizes} title={p.title} priority={priority} />
  </Cell>
) : (
  <Cell cell={cell} index={index} turno={turno}>
    {cell.type === 'svg' && <SvgCell svg={cell.svg} fit={cell.fit} riordina={cell.riordina} />}
    {cell.type === 'logotipo' && <LogotipoCell nudo={cell.frame === false} />}
    {cell.type === 'marquee' && <MarqueeCell text={cell.text} speed={cell.speed} ruotato={cell.ruotato} />}
    {cell.type === 'text' && <TextCell title={cell.title} body={cell.body} as={cell.as} size={cell.size} immagini={cell.immagini} ingrandisci={cell.ingrandisci} after={cell.after} button={cell.button} cifre={cell.cifre} sizes={sizes} />}
    {cell.type === 'list' && <ListCell items={cell.items} />}
    {cell.type === 'stat' && <StatCell value={cell.value} caption={cell.caption} countUp={cell.countUp} heading={cell.heading} />}
    {cell.type === 'media' && <MediaCell image={cell.image} video={cell.video} overlay={cell.overlay} etichette={cell.etichette} alt={cell.alt} sizes={sizes} title={cell.caption} priority={!!cell.heroOf} pila={cell.pila} immagini={cell.immagini} ingrandisci={cell.ingrandisci} fondo={cell.fondo} />}
    {cell.type === 'clock' && <ClockCell />}
    {cell.type === 'meter' && <MeterCell />}
    {cell.type === 'cursor' && <CursorCell />}
    {cell.type === 'mark' && <MarkCell />}
    {cell.type === 'eye' && <EyeCell />}
    {cell.type === 'globe' && <GlobeCell />}
    {cell.type === 'barattolo' && <BarattoloCell barattoli={cell.barattoli} title={cell.title} body={cell.body} />}
    {cell.type === 'portatile' && <PortatileCell cartella={cell.cartella} alt={cell.alt} title={cell.title} body={cell.body} button={cell.button} />}
    {cell.type === 'telefono' && <TelefonoCell video={cell.video} alt={cell.alt} title={cell.title} body={cell.body} logo={cell.logo} logoAlt={cell.logoAlt} />}
    {cell.type === 'sticker' && <StickerCell immagini={cell.immagini} alt={cell.alt} title={cell.title} body={cell.body} button={cell.button} testata={cell.testata} />}
    {cell.type === 'affissione' && <AffissioneCell affissioni={cell.affissioni} title={cell.title} sizes={sizes} />}
    {cell.type === 'sottologo' && <SottologoCell logo={cell.logo} immagini={cell.immagini} title={cell.title} body={cell.body} sizes={sizes} />}
    {cell.type === 'radio' && <RadioCell togli={!!cell.nascosta} />}
    {cell.type === 'costruzione' && <CostruzioneCell svg={cell.svg} nome={`${Astro.url.pathname} · ${cell.id}`} alt={cell.alt} title={cell.title} body={cell.body} />}
    {cell.type === 'evoluzione' && <EvoluzioneCell svg={cell.svg} nome={`${Astro.url.pathname} · ${cell.id}`} alt={cell.alt} passi={cell.passi} />}
    {cell.type === 'ridisegno' && <RidisegnoCell svg={cell.svg} alt={cell.alt} title={cell.title} body={cell.body} />}
    {cell.type === 'animato' && <AnimatoCell svg={cell.svg} alt={cell.alt} title={cell.title} body={cell.body} fondo={cell.fondo} />}
    {cell.type === 'palette' && <PaletteCell prima={cell.prima} dopo={cell.dopo} />}
    {cell.type === 'marchio' && <MarchioCell />}
    {cell.type === 'glifo' && <GlifoCell />}
    {cell.type === 'prova' && <ProvaCell testo={cell.testo} />}
    {cell.type === 'atlante' && <AtlanteCell />}
    {cell.type === 'sfumatura' && <SfumaturaCell colori={cell.colori} />}
    {cell.type === 'copertine' && <CopertineCell cartella={cell.cartella} alt={cell.alt} righe={cell.righe} />}
    {cell.type === 'versioni' && <VersioniCell versioni={cell.versioni} alt={cell.alt} />}
    {cell.type === 'punti' && <PuntiCell punti={cell.punti} />}
    {cell.type === 'collezioni' && <CollezioniCell title={cell.title} body={cell.body} collezioni={cell.collezioni} sizes={sizes} />}
    {cell.type === 'contesto' &&<ContestoCell title={cell.title} body={cell.body} image={cell.image} alt={cell.alt} fondo={cell.fondo} didascalia={cell.didascalia} sizes={sizes} />}
    {cell.type === 'error' && <ErrorCell code={cell.code} title={cell.title} />}
    {cell.type === 'archive-head' && <ArchiveHeadCell total={cell.total} />}
    {cell.type === 'tags' && <TagsCell tags={cell.tags} total={projects} />}
    {cell.type === 'contatti' && <ContattiCell piede={cell.piede !== false} />}
  </Cell>
)}
