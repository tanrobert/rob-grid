---
import type { Cell as CellData } from '../data/grid-types';
import { COLS, resolveSpans, findVoids } from '../lib/grid';
import CellContent from './CellContent.astro';

interface Props {
  cells: CellData[];
  /** Archivio: i progetti ricevono data-tags per i filtri */
  filterable?: boolean;
}
const { cells, filterable = false } = Astro.props;

const ids = new Set<string>();
for (const c of cells) {
  if (ids.has(c.id)) throw new Error(`[grid] id duplicato: "${c.id}"`);
  ids.add(c.id);
}

// buchi lasciati dall'incastro automatico, per ogni breakpoint
// la prima foto della griglia è quasi sempre l'elemento più grande in vista (LCP): caricata subito
const firstProject = cells.findIndex(c => c.type === 'project');
const projects = cells.filter(c => c.type === 'project').length;

const voids = (Object.keys(COLS) as (keyof typeof COLS)[]).flatMap(bp =>
  findVoids(cells.filter(c => !c.hideOn?.includes(bp)).map(c => resolveSpans(c)[bp]), COLS[bp]).map(v => ({ ...v, bp })),
);
---

<div class="grid" data-filterable={filterable ? '' : undefined}>
  {cells.map((cell, i) => (
    <CellContent cell={cell} index={i} filterable={filterable} priority={i === firstProject} projects={projects} />
  ))}
  {voids.map(v => (
    <div
      class:list={['void', `void--${v.bp}`]}
      style={`grid-column:${v.col} / span ${v.w};grid-row:${v.row} / span ${v.h};--cw:${v.w};--ch:${v.h};--i:${v.i}`}
      aria-hidden="true"
    ></div>
  ))}
  <div class="void void--fill" style={`--i:${cells.length}`} hidden aria-hidden="true"></div>
</div>
