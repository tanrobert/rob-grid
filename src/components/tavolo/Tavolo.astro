---
// Tavolo della home: carta quadrettata infinita e celle appoggiate sopra, da spostare, lanciare e aprire
// (comportamento in scripts/tavolo/, prototipo in tools/pages/tavolo.html). Ogni cella sta in un involucro
// .pezzo (posizione e ombra), che è quello che si muove.
// La disposizione si calcola qui per tre finestre tipo (senza JavaScript il tavolo si vede comunque) e
// nel browser per la finestra vera, prima di mostrare il tavolo.
import type { Cell } from '../../data/grid-types';
import CellContent from '../CellContent.astro';
import { inQuadretti, pack, FINESTRE, Q, versione } from '../../lib/tavolo';
import { BREAKPOINTS } from '../../lib/grid';
import { svgs } from '../../data/svgs';
import { piede } from '../../data/piede';
import Matita from '../../assets/matita.svg';

interface Props {
  cells: Cell[];
  /** sotto un foglio aperto (components/foglio): il tavolo non è la pagina. Niente <main> e niente h1
      (il titolo è quello del foglio), inerte finché il foglio resta aperto (scripts/foglio) */
  sotto?: boolean;
}
const { sotto = false } = Astro.props;
// sul tavolo il numero ce l'hanno solo i progetti (30/10/2026, scelta di Roberto): le altre celle tengono l'occhiello
const cells = Astro.props.cells
  .map(c => (c.type === 'project' ? c : { ...c, label: false as const }))
  .map(c => (sotto && c.type === 'text' && c.as === 'h1' ? { ...c, as: 'p' as const } : c));
const Radice = sotto ? 'div' : 'main';

const ids = new Set<string>();
for (const c of cells) {
  if (ids.has(c.id)) throw new Error(`[tavolo] id duplicato: "${c.id}"`);
  ids.add(c.id);
}

const misure = cells.map(c => ({ id: c.id, ...inQuadretti(c), sotto: c.sotto }));
const posti = {
  lg: pack(misure, FINESTRE.lg),
  md: pack(misure, FINESTRE.md),
  sm: pack(misure, FINESTRE.sm),
};
// intro: le celle entrano in ordine di distanza dal marchio (la prima cella, al centro). Qui sulla disposizione
// del build, nel browser su quella vera (scripts/tavolo)
const centro = (i: number) => ({ x: posti.lg[i].x + misure[i].w / 2, y: posti.lg[i].y + misure[i].h / 2 });
const lontano = (i: number) => Math.hypot(centro(i).x - centro(0).x, centro(i).y - centro(0).y);
const turni = new Map(cells.map((_, i) => i).sort((a, b) => lontano(a) - lontano(b)).map((i, n) => [i, n]));
const firstProject = cells.findIndex(c => c.type === 'project');
const projects = cells.filter(c => c.type === 'project').length;
/** numero dei progetti contati fra loro (01, 02…), non nell'ordine di tutte le celle */
const numeri = new Map(cells.flatMap((c, i) => (c.type === 'project' ? [i] : [])).map((i, n) => [i, n]));
/** sagoma dell'ombra: le celle senza filo fatte da un SVG (la R, Woberto) fanno l'ombra del disegno, non del riquadro */
/** cella del nome (ROBERTO): il nastro scrive il suo testo allo stesso corpo (--corpo-logotipo, sotto) */
const nome = misure[cells.findIndex(c => c.type === 'logotipo')];
const sagoma = (c: Cell) => (c.frame === false && c.type === 'svg' ? svgs[c.svg].component.src : undefined);
---

<Radice id={sotto ? undefined : 'main'} class="tavolo" data-tavolo data-versione={versione(misure)} inert={sotto} style={`--q-lg:${Q.lg}px;--q-sm:${Q.sm}px${nome ? `;--nome-w:${nome.w};--nome-h:${nome.h}` : ''}`}>
  <div class="tavolo__carta" data-carta aria-hidden="true"></div>
  {/* bordo del foglio (lib/tavolo.ts, confine): un quadretto di carta liscia, poi solo inchiostro.
      Bande sopra, sotto, a sinistra, a destra, e il margine */}
  <div class="tavolo__bordo" data-bordo aria-hidden="true"><div></div><div></div><div></div><div></div><div class="tavolo__margine"></div></div>
  <div class="tavolo__mondo" data-mondo>
    {/* segni della matita sul tavolo (scripts/tavolo/matita.ts): sotto le celle, in quadretti (il gruppo scala con lo zoom) */}
    <svg class="segni segni--tavolo" aria-hidden="true"><g data-segni-tavolo></g></svg>
    {cells.map((cell, i) => {
      const { w, h } = misure[i];
      const { lg, md, sm } = { lg: posti.lg[i], md: posti.md[i], sm: posti.sm[i] };
      return (
        <div
          class="pezzo"
          data-pezzo={cell.id}
          data-w={w}
          data-h={h}
          data-sotto={cell.sotto ? `${cell.sotto.id} ${cell.sotto.x} ${cell.sotto.y}` : undefined}
          style={`--qw:${w};--qh:${h};--x:${lg.x};--y:${lg.y};--x-md:${md.x};--y-md:${md.y};--x-sm:${sm.x};--y-sm:${sm.y}`}
        >
          {cell.frame !== false ? (
            <div class="pezzo__ombra" data-ombra aria-hidden="true"></div>
          )
            : sagoma(cell) && (
              <div class="pezzo__ombra pezzo__ombra--sagoma" data-ombra aria-hidden="true">
                {/* la maschera sta nel figlio: GSAP sposta il pezzo__ombra, il figlio gira con Woberto.
                    url tra virgolette: in dev il percorso ha spazi ("WEB ASTRO") e senza la maschera salta (ombra quadrata) */}
                <div class:list={['ombra__sagoma', { 'ombra__sagoma--girata': cell.type === 'svg' && cell.tinta }]} style={`--sagoma:url("${sagoma(cell)}")`}></div>
              </div>
            )}
          <CellContent
            cell={cell} index={numeri.get(i) ?? i} turno={turni.get(i)} priority={i === firstProject} projects={projects}
            sizes={`(max-width: ${BREAKPOINTS.md - 1}px) ${w * Q.sm}px, ${w * Q.lg}px`}
          />
          {/* segni della matita su questo foglio: in quadretti, seguono la cella quando si sposta */}
          <svg class="segni" data-segni viewBox={`0 0 ${w} ${h}`} preserveAspectRatio="none" aria-hidden="true"></svg>
        </div>
      );
    })}
  </div>
</Radice>

{/* ROBERTO piccolo in alto a sinistra: solo segno (il nome lo dice già la cella `nome`) */}
<span class="firma logotipo" aria-hidden="true">Roberto</span>
{/* zoom del tavolo in alto a destra (scripts/tavolo/vista.ts, scala): 1× = quadretto di base */}
<span class="zoom mono" data-zoom aria-hidden="true">1×</span>
{/* la barra in basso: a sinistra le scritte piccole dei recapiti (P.IVA, informativa, anno, versione), a destra i
    bottoni del tavolo. Se le scritte non ci stanno scorrono (scripts/tavolo/piede.ts): due serie uguali, la striscia
    si sposta di una (50%) e riparte senza stacco; la seconda serie e lo stacco servono solo quando scorre */}
<div class="barra">
  <p class="piede mono" data-piede>
    <span class="piede__nastro">
      {[0, 1].map(n => (
        <span class:list={['piede__serie', n === 1 && 'piede__copia']} aria-hidden={n === 1 ? 'true' : undefined}>
          {piede.join(' · ')}<span class="piede__stacco" aria-hidden="true">{' · '}</span>
        </span>
      ))}
    </span>
  </p>
<div class="attrezzi" role="group" aria-label="Tavolo" data-attrezzi hidden>
  {/* "Cancella tutto" c'è solo quando ci sono segni: spento sarebbe un rosso a metà (rosa) */}
  <button type="button" class="mono" data-cancella hidden>Cancella tutto</button>
  {/* la scatolina: dentro la matita, la penna di Windows 95 a pixel (tools/cursori.mjs, come il cursore); presa, ne
      resta la sagoma a retino */}
  <button type="button" class="attrezzi__matita" data-matita aria-pressed="false" aria-label="Matita" title="Matita">
    <svg class="matita__retino" aria-hidden="true">
      <defs><pattern id="matita-retino" width="2" height="2" patternUnits="userSpaceOnUse"><rect width="1" height="1" /></pattern></defs>
    </svg>
    <Matita class="matita__ico" aria-hidden="true" />
  </button>
  <button type="button" class="mono" data-riordina>Riordina</button>
  {/* "Torna al centro" tolto per ora (25/10/2026, Roberto; Riordina riporta già la vista al centro). Per rimetterlo:
      <button type="button" class="mono" data-centro>Torna al centro</button> */}
  {/* suono (scripts/suono.ts): acceso di base; altoparlante con una ✕ da spento, con le onde da acceso */}
  <button type="button" class="attrezzi__suono" data-suono aria-pressed="true" aria-label="Suono" title="Spegni il suono">
    <svg class="suono__ico" viewBox="0 0 16 16" aria-hidden="true">
      <path d="M1.5 5.5h3l4-3v11l-4-3h-3z" />
      <path class="suono__no" d="M11 6l4 4M15 6l-4 4" />
      <path class="suono__si" d="M11 5.5a3.5 3.5 0 0 1 0 5M13 3.5a6.3 6.3 0 0 1 0 9" />
    </svg>
  </button>
</div>
</div>
<style>
  /* la finestra sul tavolo: niente scroll (overflow: clip non si scorre nemmeno da script, col fuoco da tastiera)
     e niente gesti del browser, li fa scripts/tavolo/gesti.ts */
  .tavolo {
    --q: var(--q-lg);
    /* i testi delle celle si misurano sul quadretto di base, poi seguono lo zoom (global.css) */
    --q-testo: var(--q-lg);
    position: fixed; inset: 0;
    overflow: clip;
    background: var(--bianco);
    touch-action: none;
    cursor: var(--cursore-aperta);
    user-select: none; -webkit-user-select: none;
    -webkit-touch-callout: none;
  }
  .tavolo {
    /* corpo di ROBERTO nella cella del nome (stessa misura di LogotipoCell, in quadretti): il nastro lo usa per le
       sue maiuscole, così sono grandi uguali (30/10/2026, scelta di Roberto) */
    --corpo-logotipo: min((var(--nome-w) * var(--q) - 2 * var(--pad)) / var(--roberto-w), (var(--nome-h) * var(--q) - 2 * var(--pad)) / var(--maiuscole));
  }
  @media (max-width: 599px) { .tavolo { --q: var(--q-sm); --q-testo: var(--q-sm); } }
  /* mano chiusa mentre si porta il tavolo o una cella (gesti.ts), anche sopra le celle-link (se no la manina) */
  .tavolo.is-panning, .tavolo.is-panning :global(*) { cursor: var(--cursore-chiusa); }

  /* carta: quadretti e crocini (ogni 4 quadretti, sul modulo della griglia di prima). Uno strato più grande
     della finestra di un modulo per lato, che si sposta solo del resto rispetto al modulo: le linee sembrano
     infinite e il browser non ridisegna nulla. Senza JavaScript il centro del tavolo è al centro della finestra.
     Colori dalle variabili: seguono l'inversione e il contrasto alto */
  .tavolo__carta {
    --modulo: calc(var(--q) * 4);
    --carta-ink: color-mix(in srgb, var(--inchiostro) 22%, transparent);
    position: absolute;
    left: calc(var(--modulo) * -1); top: calc(var(--modulo) * -1);
    width: calc(100% + 2 * var(--modulo)); height: calc(100% + 2 * var(--modulo));
    background-image:
      linear-gradient(to right, var(--carta-ink) var(--line-dp), transparent var(--line-dp)),
      linear-gradient(to bottom, var(--carta-ink) var(--line-dp), transparent var(--line-dp));
    background-size: var(--q) var(--q);
    translate: mod(round(50vw, 1px), var(--modulo)) mod(round(50dvh, 1px), var(--modulo));
    will-change: transform;
    pointer-events: none;
  }
  /* crocini: la forma è una maschera (un SVG senza colore, centrato sull'angolo di ogni modulo: i bracci escono
     dai bordi e rientrano dal lato opposto), il colore è l'inchiostro schiarito (--crocini-ink, global.css) */
  .tavolo__carta::after {
    content: '';
    position: absolute; inset: 0;
    background: var(--crocini-ink);
    mask: var(--crocini-forma) 0 0 / var(--modulo) var(--modulo) repeat;
  }
  /* intro: la carta compare a giri quadrati dal centro del tavolo (--ox, --oy: lo scrive scripts/tavolo/vista.ts),
     un modulo per giro (o più, --passo-giro, se la finestra è grande): il giro n sfuma mentre --giro va da n
     a n+1 (crocini-in, global.css), e a intro finita --giro torna a coprire tutto */
  :global(.is-intro) .tavolo__carta {
    --ox: 50%; --oy: 50%;
    --giro: 1000;
    --a: calc(var(--giro) * var(--passo-giro, var(--modulo)));
    --b: calc(max(var(--giro) - 1, 0) * var(--passo-giro, var(--modulo)));
    --c: rgb(0 0 0 / min(1, var(--giro)));
    mask-image:
      linear-gradient(to right, transparent calc(var(--ox) - var(--a)), var(--c) calc(var(--ox) - var(--b)), var(--c) calc(var(--ox) + var(--b)), transparent calc(var(--ox) + var(--a))),
      linear-gradient(to bottom, transparent calc(var(--oy) - var(--a)), var(--c) calc(var(--oy) - var(--b)), var(--c) calc(var(--oy) + var(--b)), transparent calc(var(--oy) + var(--a)));
    mask-composite: intersect;
    animation: crocini-in 960ms linear backwards;
  }
  /* fuori dal foglio: bande di inchiostro grandi quanto la finestra, accostate al bordo da scripts/tavolo/vista.ts.
     Solo col JavaScript (senza, il tavolo non si sposta e il bordo non serve) */
  .tavolo__bordo { display: none; }
  .tavolo.is-vivo .tavolo__bordo { display: block; }
  .tavolo__bordo > div {
    position: absolute; inset: 0;
    background: var(--inchiostro);
    will-change: transform;
    pointer-events: none;
  }
  /* margine: grande quanto la griglia, l'outline copre il quadretto attorno (carta senza linee né crocini) */
  .tavolo__bordo > .tavolo__margine {
    inset: auto; left: 0; top: 0;
    background: none;
    outline: var(--q) solid var(--bianco);
  }
  .tavolo__mondo {
    position: absolute; left: 0; top: 0;
    translate: round(50vw, 1px) round(50dvh, 1px);
    will-change: transform;
  }

  /* pezzo = cella sul tavolo, posizione in quadretti dal centro (scritta al build per breakpoint) */
  .pezzo {
    position: absolute; left: 0; top: 0;
    width: calc(var(--qw) * var(--q));
    height: calc(var(--qh) * var(--q));
    translate: calc(var(--x) * var(--q)) calc(var(--y) * var(--q));
  }
  @media (max-width: 1023px) { .pezzo { translate: calc(var(--x-md) * var(--q)) calc(var(--y-md) * var(--q)); } }
  @media (max-width: 599px)  { .pezzo { translate: calc(var(--x-sm) * var(--q)) calc(var(--y-sm) * var(--q)); } }

  /* col JavaScript le posizioni sono transform scritti da GSAP */
  .tavolo.is-vivo :is(.tavolo__carta, .tavolo__mondo, .pezzo) { translate: none; }
  /* finché il JavaScript non ha disposto il tavolo per la finestra vera le celle non si vedono (niente salti);
     se non arriva compaiono lo stesso dopo un attimo, alle posizioni del build */
  :global(html.js) .tavolo:not(.is-vivo) .tavolo__mondo { visibility: hidden; animation: tavolo-attesa 0s 1.5s both; }
  @keyframes tavolo-attesa { to { visibility: visible; } }

  /* celle nascoste sotto un'altra (grid-types, `sotto`: Woberto sotto la R): sotto tutte finché non si prendono
     (scripts/tavolo/pezzi.ts, z −1), e invisibili nell'intro, per non rivelarsi */
  .pezzo[data-sotto] { z-index: -1; }
  :global(.is-intro) .pezzo[data-sotto] { visibility: hidden; }

  /* lati in quadretti per il filo dell'intro: 4 quadretti = 1 unità, quindi il tempo per quadretto è un quarto.
     Sul pezzo (tempo della caduta) e sulla cella, che altrimenti li prende dalle sue unità */
  .pezzo, .pezzo > :global(.cell) { --cw: var(--qw); --ch: var(--qh); --t-draw-u: 17.5ms; }
  .pezzo > :global(.cell) { position: absolute; inset: 0; }
  /* didascalia dei progetti: sul tavolo dentro la cella, nell'angolo in basso a sinistra (31/10/2026, scelta di
     Roberto); nei fogli resta attaccata sotto la cella (global.css) */
  .pezzo > :global(.cell > .caption) { top: auto; bottom: 0; }
  /* il marchio senza filo sta direttamente sulla carta */
  .pezzo > :global(.cell--bare) { background: transparent; }
  /* ombra della cella sollevata: retino di puntini pieni (il contrario del retino a fori sotto la cella aperta) */
  .pezzo__ombra, .ombra__sagoma {
    position: absolute; inset: 0;
    background: radial-gradient(circle at 2px 2px, var(--inchiostro) 0 1.15px, transparent 1.4px) 0 0 / 4px 4px;
  }
  /* ombra a sagoma (cella svg senza filo): lo stesso retino, ritagliato dal disegno usato come maschera */
  .pezzo__ombra--sagoma { background: none; }
  .ombra__sagoma { mask: var(--sagoma) center / 100% 100% no-repeat; }
  .ombra__sagoma--girata { rotate: 180deg; }
  /* intro, atterraggio (variante A "Secco" di tools/pages/atterraggio.html): il filo si disegna con la cella
     sollevata come in mano (misure di prendi(), scripts/tavolo/pezzi.ts); a filo finito entra il fondo, poi l'ombra
     (prima si vedrebbe attraverso la cella ancora trasparente), un attimo sospesa e giù di colpo: l'ombra rientra.
     Tempi da quando il filo ha fatto il giro: ombra +160ms, caduta +260ms per 180ms (scripts/cells.ts aspetta la fine).
     Il pezzo non si scala lui: GSAP, toccandolo la prima volta, leggerebbe `scale` e lo terrebbe per sempre. Il pezzo
     anima solo --su (1 = in mano, 0 = posata), cella e ombra lo leggono */
  :global(.is-intro) .pezzo {
    animation: pezzo-atterra 180ms cubic-bezier(0.32, 0, 0.67, 0) calc(var(--i, 0) * 30ms + var(--t-draw) + 260ms) backwards;
  }
  :global(.is-intro) .pezzo > :global(.cell) { scale: calc(1 + var(--su) * 0.035); }
  :global(.is-intro) .pezzo__ombra {
    scale: calc(1 + var(--su) * 0.035);
    translate: calc(var(--su) * var(--q) * 0.55) calc(var(--su) * var(--q) * 0.55);
    animation: ombra-compare 160ms step-end calc(var(--i, 0) * 30ms + var(--t-draw)) backwards;
  }
  @property --su { syntax: '<number>'; inherits: true; initial-value: 0; }
  @keyframes pezzo-atterra { from { --su: 1; } to { --su: 0; } }
  @keyframes ombra-compare { from, to { visibility: hidden; } }
  @media (prefers-reduced-motion: reduce) {
    :global(.is-intro) :is(.pezzo, .pezzo__ombra) { animation: none; }
  }

  /* la barra in basso, a filo del bordo (con la stessa distanza di ROBERTO in alto a sinistra): scritte a sinistra,
     bottoni a destra, sempre sulla stessa riga: se manca spazio le scritte si stringono e scorrono */
  .barra {
    position: fixed; z-index: 40;
    bottom: max(var(--gap), env(safe-area-inset-bottom));
    right: max(var(--gap), env(safe-area-inset-right));
    left: max(var(--gap), env(safe-area-inset-left));
    display: flex; align-items: flex-end; gap: var(--gap);
    pointer-events: none;
  }
  /* sul telefono, con "Cancella tutto", vanno a capo allineati a destra */
  /* i bottoni non si stringono (lo fanno le scritte); a capo solo se non lasciano nemmeno il minimo alle scritte */
  .attrezzi {
    flex: none; max-width: calc(100% - 6rem - var(--gap));
    display: flex; flex-wrap: wrap; justify-content: flex-end; gap: var(--gap); margin-left: auto;
  }
  .attrezzi > * { pointer-events: auto; }
  /* le scritte: una striscia bassa piena d'inchiostro, senza filo, a filo del fondo dei bottoni; larga quanto il
     testo e mai più dello spazio che resta (poi scorre) */
  .piede {
    flex: 0 1 auto; min-width: 6rem;  /* 6rem: anche in .attrezzi */
    display: flex; align-items: center; overflow: hidden;
    padding: 3px 8px;
    background: var(--inchiostro);
    color: var(--bianco);
    white-space: nowrap;
  }
  .piede__nastro { display: flex; }
  .piede:not(.is-scorre) :is(.piede__copia, .piede__stacco) { display: none; }
  .piede.is-scorre .piede__nastro { animation: piede-scorre var(--durata, 30s) linear infinite; }
  @keyframes piede-scorre { to { transform: translate3d(-50%, 0, 0); } }
  .attrezzi[hidden], .attrezzi [hidden] { display: none; }
  /* ROBERTO piccolo (maiuscole ~12px) in alto a sinistra. Non si prende: sotto si trascina il tavolo */
  .firma {
    position: fixed; z-index: 40;
    top: max(var(--gap), env(safe-area-inset-top));
    left: max(var(--gap), env(safe-area-inset-left));
    font-size: 18px;
    color: var(--inchiostro);
    pointer-events: none;
  }
  /* zoom in alto a destra, alla stessa distanza della firma */
  .zoom {
    position: fixed; z-index: 40;
    top: max(var(--gap), env(safe-area-inset-top));
    right: max(var(--gap), env(safe-area-inset-right));
    color: var(--inchiostro);
    pointer-events: none;
  }
  /* col foglio aperto i comandi del tavolo non servono */
  :global(html.ha-foglio:not(.is-tavolo)) :is(.barra, .firma, .zoom) { display: none; }
  .attrezzi button {
    appearance: none; margin: 0;
    padding: 10px 12px;
    background: var(--bianco);
    color: var(--inchiostro);
    border: var(--line) solid var(--inchiostro);
    cursor: var(--cursore-mano);
  }

  /* ── Matita (scripts/tavolo/matita.ts): segni neri, la mano di chi visita (il rosso è la stampa). Spessore in
     quadretti: con lo zoom il segno cresce insieme alla carta. Ogni cella ha il suo foglio di segni, tagliato
     sul suo bordo ── */
  .segni { position: absolute; inset: 0; width: 100%; height: 100%; overflow: hidden; pointer-events: none; }
  /* sopra il filo della cella (.cell::after, z 3) e la linguetta (z 2): la matita scrive anche sul bordo */
  .pezzo > .segni { z-index: 4; }
  .segni--tavolo { inset: auto; left: 0; top: 0; width: 1px; height: 1px; overflow: visible; }
  .segni :global(path) {
    fill: none; stroke: var(--nero); stroke-width: 0.12; stroke-linecap: round; stroke-linejoin: round;
  }
