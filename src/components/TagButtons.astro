---
// Pulsanti filtro: usati sia nella casella "tags" sia nella barra mobile.
import type { TagCount } from '../lib/tags';
import { pad2 } from '../lib/format';

interface Props {
  tags: TagCount[];
  total: number;
}
const { tags, total } = Astro.props;
---

<button type="button" class="tagbtn" data-tag="" aria-pressed="true">
  <span>Tutti</span><span class="mono">{pad2(total)}</span>
</button>
{tags.map(t => (
  <button type="button" class="tagbtn" data-tag={t.slug} data-label={t.tag} aria-pressed="false">
    <span>{t.tag}</span><span class="mono">{pad2(t.count)}</span>
  </button>
))}

<style>
  .tagbtn {
    display: flex; align-items: baseline; justify-content: space-between; gap: 8px;
    padding: 6px 8px 5px;
    border: 0;
    border-bottom: var(--line) solid var(--rosso);
    background: transparent;
    color: var(--rosso);
    font: 500 clamp(13px, 1.1vw, 16px) / 1.2 var(--font-testo);
    letter-spacing: -0.01em;
    text-align: left;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 200ms ease, color 200ms ease;
  }
  .tagbtn .mono { flex-shrink: 0; }
  .tagbtn[aria-pressed="true"] { background: var(--rosso); color: var(--bianco); }
  @media (hover: hover) and (pointer: fine) {
    .tagbtn[aria-pressed="false"]:hover { background: color-mix(in srgb, var(--rosso) 10%, transparent); }
  }
</style>
