---
// Pulsanti filtro: usati sia nella casella "tags" sia nella barra mobile.
interface Props {
  tags: Array<{ tag: string; slug: string; count: number }>;
  total: number;
}
const { tags, total } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<button type="button" class="tagbtn" data-tag="" aria-pressed="true">
  <span>Tutti</span><span class="mono">{pad(total)}</span>
</button>
{tags.map(t => (
  <button type="button" class="tagbtn" data-tag={t.slug} data-label={t.tag} aria-pressed="false">
    <span>{t.tag}</span><span class="mono">{pad(t.count)}</span>
  </button>
))}

<style>
  .tagbtn {
    display: flex; align-items: baseline; justify-content: space-between; gap: 8px;
    padding: 6px 8px 5px;
    border: 0;
    border-bottom: var(--line) solid var(--red);
    background: var(--paper);
    color: var(--red);
    font: 500 clamp(13px, 1.1vw, 16px) / 1.2 var(--font-sans);
    letter-spacing: -0.01em;
    text-align: left;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 200ms ease, color 200ms ease;
  }
  .tagbtn .mono { flex-shrink: 0; }
  .tagbtn[aria-pressed="true"] { background: var(--red); color: var(--paper); }
  @media (hover: hover) and (pointer: fine) {
    .tagbtn[aria-pressed="false"]:hover { background: color-mix(in srgb, var(--red) 10%, var(--paper)); }
  }
</style>
