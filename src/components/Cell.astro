---
import type { Cell } from '../data/grid-types';
import { spanStyle } from '../lib/grid';
import { pad2 } from '../lib/format';
import Arrow from '../assets/arrow.svg';
import Close from '../assets/close.svg';

interface Props {
  cell: Cell;
  index: number;
  /** href calcolato (es. per i progetti), ha la precedenza su cell.href */
  href?: string;
  /** attributi extra sull'elemento (es. data-tags nell'archivio) */
  attrs?: Record<string, string>;
  /** turno nell'intro, se diverso dall'ordine di lettura (sul tavolo: per distanza dal marchio) */
  turno?: number;
}

const { cell, index, attrs = {}, turno = index } = Astro.props;
const href = Astro.props.href ?? cell.href;
const n = pad2(index + 1);

const classes = ['cell', `cell--${cell.type}`, cell.tone === 'red' && 'cell--red', cell.frame === false && 'cell--bare', href && 'cell--link', ...(cell.hideOn ?? []).map(bp => `hide-${bp}`)];
const isHome = href === '/';
// linguetta: solo il numero (il nome lo dicono già titolo, occhiello o didascalia); label: false = niente linguetta
const showLabel = cell.label !== false;

// hero del foglio (data-hero = indirizzo della pagina): da lì il foglio si apre e si chiude (scripts/foglio)
const hero = cell.heroOf;

// cella cliccabile → <a> (il link a "/" chiude il foglio); altrimenti <div>.
// data-replace: la pagina sostituisce quella corrente nella cronologia (precedente/successivo)
const Tag = href ? 'a' : 'div';
const linkAttrs = href
  ? { href, 'data-close': isHome ? '' : undefined, 'data-replace': cell.replace ? '' : undefined }
  : { 'data-hero': hero };
---

<Tag
  class:list={classes}
  style={`${spanStyle(cell)};--i:${turno}`}
  data-cell={cell.type}
  data-id={cell.id}
  {...linkAttrs}
  {...attrs}
>
  {showLabel && <span class="cell__label mono" aria-hidden="true"><span>{n}</span></span>}
  {href && <span class="cell__go" aria-hidden="true" data-part="go"><span><Arrow /></span></span>}
  {!href && hero && <a href="/" class="cell__go" aria-label="Chiudi e torna al tavolo" data-close data-part="go"><span><Close /></span></a>}
  <slot />
</Tag>
