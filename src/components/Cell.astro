---
import type { Cell } from '../data/grid-types';
import { spanStyle, morphName } from '../lib/grid';
import { pad2 } from '../lib/format';
import Arrow from '../assets/arrow.svg';
import Close from '../assets/close.svg';

interface Props {
  cell: Cell;
  index: number;
  /** href calcolato (es. per i progetti), ha la precedenza su cell.href */
  href?: string;
  /** attributi extra sull'elemento (es. data-tags nell'archivio) */
  attrs?: Record<string, string>;
}

const { cell, index, attrs = {} } = Astro.props;
const href = Astro.props.href ?? cell.href;
const n = pad2(index + 1);

const classes = ['cell', `cell--${cell.type}`, cell.tone === 'red' && 'cell--red', href && 'cell--link', ...(cell.hideOn ?? []).map(bp => `hide-${bp}`)];
const isHome = href === '/';
const label = cell.label === false ? null : (cell.label ?? cell.id);

// cella "hero": è il punto d'arrivo dell'espansione da un'altra pagina
const hero = cell.heroOf ? morphName(cell.heroOf) : undefined;
const style = `${spanStyle(cell)};--i:${index}${hero ? `;view-transition-name:${hero};view-transition-class:morph` : ''}`;

// cella cliccabile → <a> (il link a "/" chiude la pagina corrente); altrimenti <div>
const Tag = href ? 'a' : 'div';
const linkAttrs = href
  ? { href, 'data-morph': isHome ? undefined : morphName(href), 'data-close': isHome ? '' : undefined }
  : { 'data-hero': hero };
---

<Tag
  class:list={classes}
  style={style}
  data-cell={cell.type}
  data-id={cell.id}
  {...linkAttrs}
  {...attrs}
>
  {label && (
    <span class="cell__label mono" aria-hidden="true">
      <span>{n}</span><span>{label}</span>
    </span>
  )}
  {href && <span class="cell__go" aria-hidden="true"><span><Arrow /></span></span>}
  {!href && hero && <a href="/" class="cell__go" aria-label="Chiudi e torna alla griglia" data-close><span><Close /></span></a>}
  <slot />
</Tag>
