---
import type { Cell } from '../data/grid-types';
import { spanStyle } from '../lib/grid';
import { pad2 } from '../lib/format';
import Arrow from '../assets/arrow.svg';
import Close from '../assets/close.svg';

interface Props {
  cell: Cell;
  index: number;
  /** href calcolato (es. per i progetti), ha la precedenza su cell.href */
  href?: string;
  /** attributi extra sull'elemento (es. data-tags nell'archivio) */
  attrs?: Record<string, string>;
}

const { cell, index, attrs = {} } = Astro.props;
const href = Astro.props.href ?? cell.href;
const n = pad2(index + 1);

const classes = ['cell', `cell--${cell.type}`, cell.tone === 'red' && 'cell--red', href && 'cell--link', ...(cell.hideOn ?? []).map(bp => `hide-${bp}`)];
const isHome = href === '/';
const label = cell.label === false ? null : (cell.label ?? cell.id);

// Espansione (scripts/morph.ts): la cella cliccabile si apre nella hero della pagina (data-hero = suo href);
// nella pagina d'arrivo la cella del titolo (data-title-of) accoglie la barra della didascalia
const hero = cell.heroOf;
const titleOf = 'titleOf' in cell ? cell.titleOf : undefined;

// cella cliccabile → <a> (il link a "/" chiude la pagina corrente); altrimenti <div>
const Tag = href ? 'a' : 'div';
const linkAttrs = href
  ? { href, 'data-morph': isHome ? undefined : href, 'data-close': isHome ? '' : undefined }
  : { 'data-hero': hero, 'data-title-of': titleOf };
---

<Tag
  class:list={classes}
  style={`${spanStyle(cell)};--i:${index}`}
  data-cell={cell.type}
  data-id={cell.id}
  {...linkAttrs}
  {...attrs}
>
  {label && (
    <span class="cell__label mono" aria-hidden="true">
      <span>{n}</span><span>{label}</span>
    </span>
  )}
  {href && <span class="cell__go" aria-hidden="true" data-part="go"><span><Arrow /></span></span>}
  {!href && hero && <a href="/" class="cell__go" aria-label="Chiudi e torna alla griglia" data-close data-part="go"><span><Close /></span></a>}
  <slot />
</Tag>
