---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props {
  image?: ImageMetadata;
  video?: string;
  alt: string;
  sizes: string;
  /** Titolo e meta mostrati in basso, sulla foto */
  title?: string;
  meta?: string;
  /** Hero della pagina: caricata subito, deve esserci già quando la cella si espande */
  priority?: boolean;
  /** Versione in bianco e nero (lib/grigio.ts), sopra quella a colori: celle progetto */
  grey?: ImageMetadata;
}
const { image, video, alt, sizes, title, meta, priority = false, grey } = Astro.props;
const poster = image && video ? await getImage({ src: image, width: 1280, format: 'webp' }) : undefined;
---

<div class="duo" data-part="media">
  {video ? (
    <video data-autoplay muted loop playsinline preload="none" poster={poster?.src} aria-label={alt || undefined}>
      <source src={video} type="video/mp4" />
    </video>
  ) : image && (
    <Image src={image} alt={alt} widths={[400, 800, 1200, 1600, 2400]} sizes={sizes} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} decoding="async" />
  )}
  {grey && !video && <Image class="duo__grigio" src={grey} alt="" widths={[400, 800, 1200, 1600, 2400]} sizes={sizes} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} decoding="async" aria-hidden="true" />}
</div>

{title && (
  <div class="caption">
    <span class="caption__title" data-part="title">{title}</span>
    {meta && <span class="mono">{meta}</span>}
  </div>
)}

<style>
  .caption {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 2;
    display: flex; justify-content: space-between; align-items: baseline; gap: 2px var(--m);
    /* se titolo e data non stanno su una riga (celle strette, titoli lunghi) la data sale sopra, come un occhiello */
    flex-wrap: wrap-reverse;
    padding: 8px 12px 7px;
  }
  .caption__title {
    font-weight: 500;
    font-size: 15px;
    letter-spacing: -0.01em;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .caption .mono { flex-shrink: 0; }
</style>
