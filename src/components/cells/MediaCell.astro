---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  image?: ImageMetadata;
  video?: string;
  alt: string;
  sizes: string;
  /** Titolo nella didascalia sotto la cella (global.css, .caption) */
  title?: string;
  /** Hero della pagina: caricata subito, deve esserci già quando la cella si espande */
  priority?: boolean;
}
const { image, video, alt, sizes, title, priority = false } = Astro.props;
const poster = image && video ? await getImage({ src: image, width: 1280, format: 'webp' }) : undefined;
// se accanto all'mp4 (H.264, per tutti) c'è lo stesso nome in .webm (AV1, molto più leggero), chi lo sa leggere usa quello
const webm = video?.replace(/\.mp4$/, '.webm');
const conWebm = !!webm && webm !== video && fs.existsSync(path.join(process.cwd(), 'public', webm));
---

<div class="duo">
  {video ? (
    <video data-autoplay muted loop playsinline preload="none" poster={poster?.src} aria-label={alt || undefined}>
      {conWebm && <source src={webm} type='video/webm; codecs="av01.0.05M.08"' />}
      <source src={video} type="video/mp4" />
    </video>
  ) : image && (
    <Image src={image} alt={alt} widths={[400, 800, 1200, 1600, 2400]} sizes={sizes} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} decoding="async" />
  )}
</div>

{title && (
  <div class="caption">
    <span class="caption__title">{title}</span>
  </div>
)}
