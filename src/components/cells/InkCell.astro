---
// Interruttore della luce: sole = luce accesa (inchiostro rosso), luna = spenta (nero). Si alternano con un'eclisse:
// i raggi girano e rientrano, un secondo cerchio ("morso") scivola sul disco e lascia la falce. Il disco è lo stesso
// per sole e luna e non si muove mai: sempre al centro della cella. Contorni da 1px come i fili del sito. Le due maschere fanno la falce solo a contorno: il disco si
// vede fuori dal morso, il bordo del morso si vede solo dentro il disco. Lontano dal disco (sole) il morso sparisce.
// Al clic: scripts/ink.ts. Colore in global.css (--inchiostro). Geometria in un quadrato 100×100 centrato su (50,50).
const rays = Array.from({ length: 8 }, (_, i) => {
  const a = (i * Math.PI) / 4;
  const f = (n: number) => n.toFixed(2);
  return { x1: f(50 + 30 * Math.sin(a)), y1: f(50 - 30 * Math.cos(a)), x2: f(50 + 40 * Math.sin(a)), y2: f(50 - 40 * Math.cos(a)), i };
});
---

<button class="switch" type="button" role="switch" aria-checked="true" aria-label="Luce" title="Spegni la luce" data-ink>
  <svg viewBox="0 0 100 100" data-lens aria-hidden="true">
    <defs>
      <mask id="luce-fuori" maskUnits="userSpaceOnUse" x="0" y="0" width="100" height="100">
        <rect width="100" height="100" fill="#fff" />
        <circle class="bite" cx="50" cy="50" r="18" fill="#000" />
      </mask>
      <mask id="luce-dentro" maskUnits="userSpaceOnUse" x="0" y="0" width="100" height="100">
        <circle cx="50" cy="50" r="22" fill="#fff" />
      </mask>
    </defs>
    <g class="rays">
      {rays.map(r => <line x1={r.x1} y1={r.y1} x2={r.x2} y2={r.y2} pathLength="1" style={`--i:${r.i}`} />)}
    </g>
    <g mask="url(#luce-fuori)"><circle cx="50" cy="50" r="22" /></g>
    <g mask="url(#luce-dentro)"><circle class="bite" cx="50" cy="50" r="18" /></g>
  </svg>
</button>

<style>
  /* cella bianca come le altre, senza linguetta (label: false in data/grid.ts): l'icona è dell'inchiostro, rossa o nera */
  /* reset del bottone uno per uno: `all: unset` toglierebbe anche l'animazione d'ingresso (.is-intro .cell > *) */
  .switch {
    appearance: none; background: none; border: 0; margin: 0;
    color: inherit; font: inherit; letter-spacing: inherit; text-transform: inherit;
    box-sizing: border-box;
    position: absolute; inset: 0;
    display: grid; place-items: center;
    cursor: pointer;
  }
  .switch:focus-visible { outline: 2px solid var(--inchiostro); outline-offset: -8px; }

  svg { display: block; width: 80cqmin; height: 80cqmin; overflow: visible; }
  circle, line { fill: none; stroke: currentColor; stroke-width: var(--line); vector-effect: non-scaling-stroke; }
  mask circle, mask rect { stroke: none; }
  mask circle { fill: #fff; }
  mask .bite { fill: #000; }

  /* sole (stato di base). Tempi: --t-sole, l'eclisse dura quanto il cerchio del colore (--t-ink) */
  .switch { --t-sole: 720ms; --molla: cubic-bezier(0.3, 1.4, 0.5, 1); }
  .rays, .bite { transform-box: view-box; transform-origin: 50% 50%; }
  .rays { transition: transform var(--t-sole) var(--ease-out); }
  /* raggi: pathLength 1, il tratto scivola verso il centro e rientra nel disco */
  .rays line {
    stroke-dasharray: 1 1; stroke-dashoffset: 0;
    transition: stroke-dashoffset 360ms var(--ease-out);
    transition-delay: calc(240ms + var(--i) * 20ms);
  }
  /* morso fuori dal disco, in alto a destra (a 42 dal centro: oltre 22 + 18, non tocca il disco) */
  .bite { transform: translate(30px, -30px); transition: transform var(--t-sole) var(--molla); }

  /* luna: i raggi girano e rientrano (uno dopo l'altro), poi il morso scivola sul disco */
  :global(:root[data-inchiostro="nero"]) .rays { transform: rotate(90deg); }
  :global(:root[data-inchiostro="nero"]) .rays line { stroke-dashoffset: 1; transition-delay: calc(var(--i) * 20ms); }
  :global(:root[data-inchiostro="nero"]) .bite { transform: translate(11px, -9px); transition-delay: 160ms; }

  @media (hover: hover) and (pointer: fine) {
    /* col mouse sopra il sole gira di un ottavo di raggio, la luna si assottiglia */
    .switch:hover .rays { transform: rotate(22.5deg); }
    :global(:root[data-inchiostro="nero"]) .switch:hover .bite { transform: translate(8.5px, -7px); }
  }
</style>
