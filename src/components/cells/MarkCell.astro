---
// Segno di registro con ghiera graduata che ruota lentamente.
const ticks = Array.from({ length: 72 }, (_, i) => {
  const a = (i * 5 * Math.PI) / 180;
  const long = i % 6 === 0;
  const r1 = 46, r2 = long ? 38 : 42;
  const f = (n: number) => n.toFixed(2);
  return { x1: f(50 + r1 * Math.sin(a)), y1: f(50 - r1 * Math.cos(a)), x2: f(50 + r2 * Math.sin(a)), y2: f(50 - r2 * Math.cos(a)) };
});
---

<div class="mark" aria-hidden="true">
  <svg viewBox="0 0 100 100" fill="none" stroke="currentColor">
    <g class="ring loop">
      {ticks.map(t => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} vector-effect="non-scaling-stroke" />)}
    </g>
    <circle cx="50" cy="50" r="22" vector-effect="non-scaling-stroke" />
    <circle cx="50" cy="50" r="3" fill="currentColor" />
    <path d="M50 18v64M18 50h64" vector-effect="non-scaling-stroke" />
  </svg>
</div>

<style>
  .mark {
    position: absolute; inset: 0;
    display: grid; place-items: center;
    padding: calc(var(--pad) + 12px);
  }
  svg { width: 100%; height: 100%; stroke-width: var(--line); }
  .ring {
    transform-box: fill-box;
    transform-origin: center;
    animation: spin 48s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>
