---
// Un sottologo con le sue applicazioni (Kiale: I panini di Zio Chècco): titolone in alto, in mezzo una vetrina dove si
// alternano il logo che si compone (data/loghi.ts, scripts/sottologo.ts) e le foto scontornate (la carta del panino,
// la busta), il paragrafo in fondo. A ogni cambio la scena vecchia sfuma via e poi entra la nuova; il logo si
// ricompone ogni volta che torna. Senza JavaScript resta il logo, già composto.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { loghi } from '../../data/loghi';
import Paragrafi from '../Paragrafi.astro';

interface Props {
  logo: string;
  immagini: Array<{ image: ImageMetadata; alt: string; lato?: 'sinistra' }>;
  title?: string;
  body?: string;
  sizes: string;
}
const { logo, immagini, title, body, sizes } = Astro.props;
const svg = loghi[logo];
if (!svg) throw new Error(`[sottologo] logo sconosciuto: "${logo}" (i nomi sono in data/loghi.ts)`);
---

<div class="sottologo" data-sottologo>
  {title && <div class="testo"><h2 class="titolo" data-lente="inversa">{title}</h2></div>}
  <div class="vetrina" data-vetrina>
    <div class="scena is-attiva"><Fragment set:html={svg} /></div>
    {immagini.map(im => (
      <div class:list={['scena', im.lato && `scena--${im.lato}`]}>
        <Image src={im.image} alt={im.alt} widths={[400, 800, 1200]} sizes={sizes} loading="lazy" decoding="async" />
      </div>
    ))}
  </div>
  {body && <div class="body"><Paragrafi testo={body} /></div>}
</div>

<style>
  /* in colonna: titolone, la vetrina in tutto lo spazio che resta, il paragrafo in fondo */
  .sottologo { position: absolute; inset: 0; display: grid; grid-template: auto minmax(0, 1fr) auto / minmax(0, 1fr); }
  .testo { padding: var(--pad-label) var(--pad) 0; pointer-events: none; }
  .titolo {
    font-family: var(--font-testo); font-weight: 900; line-height: 0.85; letter-spacing: -0.05em;
    font-size: var(--titolone);
  }
  .vetrina { position: relative; cursor: pointer; }
  /* logo e foto nello stesso riquadro, interi: le foto sono ritagliate sul loro contorno */
  .scena { position: absolute; inset: var(--pad); }
  .scena > :global(svg), .scena img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  /* cambio di scena: le foto sono scontornate, quindi la vecchia esce prima che entri la nuova (sovrapposte si
     vedrebbero l'una attraverso l'altra) */
  .scena { opacity: 0; transition: opacity 300ms ease; }
  .scena.is-attiva { opacity: 1; transition-delay: 300ms; }
  /* foto attaccata al lato sinistro (la busta tenuta in mano: il braccio arriva dal bordo): larga quanto la cella
     meno il margine a destra, posata in fondo, sale fino a una riga del titolone; il tutto al 90% (--busta), così
     tocca appena il titolone. Entra scivolando da sinistra ed esce di là, nello stesso tempo in cui le altre
     sfumano; fuori dalla cella la taglia la cella (overflow: clip) */
  .scena--sinistra {
    --busta: 0.9;
    inset: 0; opacity: 1; translate: -100% 0;
    transition: translate 300ms cubic-bezier(0.5, 0, 0.75, 0);
  }
  .scena--sinistra.is-attiva { translate: 0 0; transition: translate 600ms cubic-bezier(0.2, 0.8, 0.2, 1) 300ms; }
  .scena--sinistra img {
    inset: auto auto 0 0; width: calc((100% - var(--pad)) * var(--busta)); height: auto;
    max-height: calc((100% + var(--titolone)) * var(--busta));
    object-position: left bottom;
  }
  .body { padding: var(--pad); max-width: 44ch; font-size: var(--paragrafo); line-height: 1.35; }
</style>
