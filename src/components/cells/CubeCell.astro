---
// Il logo diventa la faccia frontale di un cubo che, all'hover della cella,
// ruota su una faccia a caso (vedi scripts/cells.ts). La cella resta ferma.
import SvgAsset from '../SvgAsset.astro';
import { svgs, type SvgName } from '../../data/svgs';

interface Props {
  svg: SvgName;
}
const { svg } = Astro.props;
const faces = ['front', 'back', 'right', 'left', 'top', 'bottom'];
---

<div class="scene" role="img" aria-label={svgs[svg].label}>
  <div class="cube" data-cube>
    {faces.map(f => (
      <div class:list={['face', `face--${f}`]}>
        <SvgAsset name={svg} />
      </div>
    ))}
  </div>
</div>

<style>
  .scene {
    /* lato del cubo = lato del logo nella cella */
    --s: calc(min(100cqi, 100cqb) - 2 * var(--pad));
    position: absolute; inset: 0;
    display: grid; place-items: center;
    perspective: calc(var(--s) * 4);
  }
  .cube {
    --rx: 0deg;
    --ry: 0deg;
    position: relative;
    width: var(--s); height: var(--s);
    transform-style: preserve-3d;
    /* ruota sul proprio centro, poi arretra di mezzo lato: a riposo la faccia frontale è sul piano della cella */
    transform: translateZ(calc(var(--s) / -2)) rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 900ms var(--ease-morph);
  }
  .face {
    position: absolute; inset: 0;
    display: grid; place-items: center;
    background: var(--paper);
    backface-visibility: hidden;
  }
  :global(.cell--red) .face { background: var(--red); }
  .face :global(svg) { width: 100%; height: 100%; }

  .face--front  { transform: translateZ(calc(var(--s) / 2)); }
  .face--back   { transform: rotateY(180deg) translateZ(calc(var(--s) / 2)); }
  .face--right  { transform: rotateY(90deg) translateZ(calc(var(--s) / 2)); }
  .face--left   { transform: rotateY(-90deg) translateZ(calc(var(--s) / 2)); }
  .face--top    { transform: rotateX(90deg) translateZ(calc(var(--s) / 2)); }
  .face--bottom { transform: rotateX(-90deg) translateZ(calc(var(--s) / 2)); }
</style>
