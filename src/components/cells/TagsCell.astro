---
import TagButtons from '../TagButtons.astro';
import type { TagCount } from '../../lib/tags';

interface Props {
  tags: TagCount[];
  total: number;
}
const { tags, total } = Astro.props;
---

<div class="tags" role="group" aria-label="Filtra i progetti per tag">
  <TagButtons tags={tags} total={total} />
</div>

<style>
  .tags {
    position: absolute; inset: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    align-content: end;
    column-gap: var(--pad);
    padding: var(--pad-label) var(--pad) var(--pad);
    /* scroll interno solo se i tag non ci stanno; niente overscroll-behavior: contain,
       altrimenti Firefox blocca la rotella sulla casella anche quando non c'è nulla da scorrere */
    overflow: auto;
  }
</style>
