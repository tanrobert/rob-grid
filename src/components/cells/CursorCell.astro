---
// Mini-mappa del viewport: il punto segue il puntatore.
---

<div class="cursor" data-cursor aria-hidden="true">
  <div class="frame" data-frame>
    <span class="axis axis--x" data-ax></span>
    <span class="axis axis--y" data-ay></span>
    <span class="dot" data-dot></span>
  </div>
  <p class="mono xy"><span>X <b data-x>0000</b></span><span>Y <b data-y>0000</b></span></p>
</div>

<style>
  .cursor {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; justify-content: flex-end; gap: var(--m);
    padding: var(--pad-label) var(--pad) var(--pad);
  }
  .frame {
    position: relative;
    flex: 1;
    border: var(--line) solid currentColor;
    overflow: hidden;
  }
  .axis, .dot { position: absolute; top: 0; left: 0; will-change: transform; }
  .axis--x { width: var(--line); height: 100%; background: currentColor; opacity: 0.35; }
  .axis--y { height: var(--line); width: 100%; background: currentColor; opacity: 0.35; }
  .dot {
    width: 7px; height: 7px; margin: -3px 0 0 -3px;
    background: currentColor;
  }
  .xy { display: flex; justify-content: space-between; }
  .xy b { font-weight: 400; }
</style>
