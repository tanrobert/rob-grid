---
interface Props {
  value: string;
  caption: string;
  countUp?: boolean;
  heading?: string;
}
const { value, caption, countUp = false, heading } = Astro.props;
---

<div class="stat">
  {heading && <h1 class="sr-only">{heading}</h1>}
  <p class="cifra" style={`--len:${Math.max(2, value.length)}`} data-countup={countUp ? '' : undefined}>{value}</p>
  <p class="mono">{caption}</p>
</div>

<style>
  .stat {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; justify-content: flex-end; gap: var(--m);
    padding: var(--pad);
  }
</style>
