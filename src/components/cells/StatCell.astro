---
interface Props {
  value: string;
  caption: string;
  countUp?: boolean;
  heading?: string;
}
const { value, caption, countUp = false, heading } = Astro.props;
---

<div class="stat">
  {heading && <h1 class="sr-only">{heading}</h1>}
  <p class="value" style={`--len:${Math.max(2, value.length)}`} data-part="num" data-countup={countUp ? '' : undefined}>{value}</p>
  <p class="mono">{caption}</p>
</div>

<style>
  .stat {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; justify-content: flex-end; gap: var(--m);
    padding: var(--pad);
  }
  .value {
    /* largo quanto il testo: nell'espansione il numero cresce senza deformarsi (morph.ts) */
    align-self: flex-start;
    font-weight: 500;
    font-size: min(58cqb, calc(124cqi / var(--len)));
    line-height: 0.78;
    letter-spacing: -0.06em;
    font-variant-numeric: tabular-nums;
    margin-left: -0.06em;
  }
</style>
