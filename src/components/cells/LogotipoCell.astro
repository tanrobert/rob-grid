---
// ROBERTO scritto col font del logotipo (classe .logotipo in global.css), il più grande che sta nella cella.
// `nudo` (cella senza filo, 31/10/2026): la cella è la parola. La R alta quanto la cella (sulle linee della carta),
// a filo del lato sinistro; la O sborda di 0,012 em sopra e sotto, come nel disegno del font
interface Props { nudo?: boolean }
const { nudo = false } = Astro.props;
---

<div class:list={['logotipo-cella', { 'logotipo-cella--nudo': nudo }]}>
  <p class="logotipo">Roberto</p>
</div>

<style>
  .logotipo-cella {
    position: absolute; inset: 0;
    display: grid; place-items: center;
    padding: var(--pad);
  }
  .logotipo {
    font-size: min((100cqw - 2 * var(--pad)) / var(--roberto-w), (100cqh - 2 * var(--pad)) / var(--maiuscole));
  }
  /* ROBERTO sulla carta, sotto la R: rosso come lei (1/11/2026) */
  /* overflow-x: clip: la scatola del testo (non l'inchiostro) sborda a destra di qualche px, e sul telefono, con le
     celle a filo dello schermo, faceva scorrere la pagina di lato (la hero di /rob-display). In verticale la O sborda e resta */
  .logotipo-cella--nudo { padding: 0; justify-items: start; color: var(--rosso); overflow-x: clip; }
  /* la R alta quanto la cella, ma mai più larga di lei (la hero di /rob-display, sul tablet e sul telefono) */
  .logotipo-cella--nudo .logotipo { font-size: min(100cqh / var(--maiuscole), 100cqw / var(--roberto-w)); }
</style>
