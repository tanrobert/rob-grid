---
// Barattoli col mockup vero: l'etichetta piatta avvolta sul cilindro misurato nel PSD (tools/barattolo-mockup.py,
// livelli in public/barattolo/<mockup>), che si gira trascinando e si sfoglia con ‹ ›. Ogni barattolo ha il suo vaso,
// il più grande che ci sta e centrato (non più alla stessa scala degli altri). Disegnati da scripts/barattolo.ts, caricato solo se la cella c'è e quando si avvicina allo schermo.
// In colonna: titolo grande in alto a sinistra (due righe), i barattoli sotto, che ci salgono sopra fin quasi a metà
// dell'ultima riga. Laboratorio: tools/pages/barattolo.html.
import fs from 'node:fs';
import path from 'node:path';
import sharp from 'sharp';
import type { Barattolo } from '../../data/grid-types';
import { pad2 } from '../../lib/format';

interface Props {
  barattoli: Barattolo[];
  title?: string;
  body?: string | string[];
}
const { barattoli, title, body } = Astro.props;

// geometria misurata dallo strumento: letta al build, così lo script non la deve scaricare
// `largo` e `centro`: quanto è largo il vetro e dove sta il suo mezzo (nel ritaglio non è al centro, ed è inclinato),
// senza l'ombra che sfuma nella carta: in larghezza conta solo lui. `piede`: il punto più basso del vetro, per centrare
// il vaso e posarci l'ombra
const geometria = async (m: string) => {
  const cartella = path.join(process.cwd(), 'public', 'barattolo', m);
  const G = JSON.parse(fs.readFileSync(path.join(cartella, 'geometria.json'), 'utf8'));
  const { data, info } = await sharp(path.join(cartella, 'vaso.webp')).ensureAlpha().raw().toBuffer({ resolveWithObject: true });
  let x0 = info.width, x1 = 0, y1 = 0;
  for (let i = 3; i < data.length; i += 4) if (data[i] > 8) { const x = ((i - 3) / 4) % info.width; x0 = Math.min(x0, x); x1 = Math.max(x1, x); y1 = Math.floor((i - 3) / 4 / info.width); }
  const largo = (x1 + 1 - x0) * G.w / info.width, centro = (x0 + x1 + 1) / 2 * G.w / info.width;
  const piede = (y1 + 1) * G.h / info.height;
  return { w: G.w, h: G.h, cx: G.cx, cy: G.cy, ang: G.ang, r: G.r, t0: G.t0, t1: G.t1, e: G.e, piano: G.piano, cima: G.cima, largo, centro, piede };
};
const vasi = [...new Set(barattoli.map(b => b.mockup))];
const dati = {
  mockup: Object.fromEntries(await Promise.all(vasi.map(async m => [m, await geometria(m)]))),
  barattoli: barattoli.map(b => ({
    nome: b.nome, mockup: b.mockup, src: b.etichetta.src, bordo: b.bordo?.src, parola: b.parola?.src,
    tipo: b.tipo, dentro: b.dentro, pezzi: b.pezzi,
  })),
};
const primo = barattoli[0].nome;
---

<div class="barattolo" data-barattolo={JSON.stringify(dati)}>
  <canvas class="carta" data-carta aria-hidden="true"></canvas>
  <canvas class="carta" data-ombra aria-hidden="true"></canvas>
  <div class="vetrina">
    {(title || body) && (
      <div class="testo">
        {title && <h2 class="titolo" data-righe="3">{title}</h2>}
        {typeof body === 'string' && <p class="body">{body}</p>}
        {Array.isArray(body) && body.map(p => <p class="body">{p}</p>)}
      </div>
    )}
    <div class="parola" data-parola aria-hidden="true"></div>
    <canvas class="tela" data-tela role="img" aria-label={`${primo}: trascina per girare il barattolo`}></canvas>
    <div class="caption">
      <span class="caption__title" data-nome aria-live="polite">{primo}</span>
      {barattoli.length > 1 && (
        <span class="sfoglia mono">
          <button type="button" data-passo="-1" aria-label="Barattolo precedente">‹</button>
          <span data-conta>{pad2(1)}/{pad2(barattoli.length)}</span>
          <button type="button" data-passo="1" aria-label="Barattolo successivo">›</button>
        </span>
      )}
    </div>
  </div>
</div>

<style>
  /* in colonna (la vetrina, a griglia): titolo a tutta larghezza; sotto, nella stessa riga, la tela dei barattoli (dal
     titolo alla didascalia) e la parola della linea girata sul lato sinistro, dietro. Il vaso alto va dal titolo alla
     didascalia, i vasetti al centro (scelte di Roberto del 29/10/2026). Il bordo dell'etichetta in fondo, subito sopra
     la didascalia */
  .barattolo { position: absolute; inset: 0; }
  /* il bordo dell'etichetta in fondo, sotto il barattolo e sopra la didascalia (scripts/barattolo.ts): la tela del barattolo è
     trasparente fuori dalla sagoma del vaso. Sopra la carta, la tela dell'ombra a terra (stessa misura) */
  .carta { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .vetrina { position: absolute; inset: 0; display: grid; grid-template-rows: auto minmax(0, 1fr) 40px; }
  .testo { grid-row: 1; grid-column: 1; }
  .tela {
    position: relative; z-index: 1;
    grid-row: 2; grid-column: 1; width: 100%; height: 100%;
    cursor: var(--cursore-aperta);
    /* col dito si gira e si sfoglia solo in orizzontale: il gesto verticale resta allo scroll della pagina */
    touch-action: pan-y;
    user-select: none;
  }
  .tela:active { cursor: var(--cursore-chiusa); }
  /* la parola della linea (Confetture, Sughi…): l'SVG fa da maschera, il colore è quello del bordo del barattolo
     (scripts/barattolo.ts). Girata di 90° in senso antiorario sul lato sinistro (destro coi vasi alti: .parola--destra),
     appoggiata sopra la fascia del bordo (--bordo-alto, scritto dallo script) con un modulo d'aria: un riquadro lungo
     quanto la cella e alto 17cqi, la parola all'inizio, girato attorno al suo centro e portato a --pad dal lato */
  .parola {
    grid-row: 2; grid-column: 1; align-self: end; justify-self: start;
    width: 100cqi; height: 17cqi; margin-left: var(--pad);
    --sopra: calc(var(--bordo-alto, 22cqi) + var(--m));
    translate: calc(8.5cqi - 50cqi) calc(8.5cqi - 50cqi - var(--sopra)); rotate: -90deg;
    background-color: var(--parola-colore, transparent);
    mask: var(--parola) left center / contain no-repeat;
    opacity: 0; pointer-events: none;
    transition: background-color 520ms cubic-bezier(.45, 0, .55, 1);
  }
  .parola--destra { justify-self: end; margin: 0 var(--pad) 0 0; translate: calc(50cqi - 8.5cqi) calc(8.5cqi - 50cqi - var(--sopra)); }
  .caption {
    position: absolute; left: 0; right: 0; bottom: 0;
    display: flex; justify-content: space-between; align-items: center; gap: var(--m);
    padding: 0 0 0 var(--pad); min-height: 40px;
  }
  .caption__title {
    font-weight: 500; font-size: 15px; letter-spacing: -0.01em;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .sfoglia { display: flex; align-items: center; flex-shrink: 0; font-variant-numeric: tabular-nums; }
  .sfoglia button {
    width: 30px; height: 30px; padding: 0;
    border: 0; background: none; color: inherit; font: inherit; font-size: 15px;
    touch-action: manipulation;
  }

  /* sotto il barattolo, e non blocca i gesti */
  .testo {
    display: flex; flex-direction: column; gap: var(--m);
    padding: var(--pad-label) var(--pad) 0;
    pointer-events: none;
  }
  .titolo {
    font-family: var(--font-testo); font-weight: 900; line-height: 0.85; letter-spacing: -0.05em;
    /* corpo: il più grande con cui sta in tre righe (scripts/titoloni.ts); questo senza JavaScript */
    font-size: 11cqi;
  }
  .body { font-size: 14px; line-height: 1.35; }
</style>
