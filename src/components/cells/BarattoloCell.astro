---
// Barattoli col mockup vero: l'etichetta piatta avvolta sul cilindro misurato nel PSD (tools/barattolo-mockup.py,
// livelli in public/barattolo/<mockup>), che si gira trascinando e si sfoglia col righello. Ogni barattolo ha il suo vaso,
// il più grande che ci sta e centrato (non più alla stessa scala degli altri). Disegnati da scripts/barattolo.ts, caricato solo se la cella c'è e quando si avvicina allo schermo.
// In colonna: titolo in alto a sinistra (--titolone), sotto la parola della linea, poi i barattoli. Laboratorio: tools/pages/barattolo.html.
import Paragrafi from '../Paragrafi.astro';
import fs from 'node:fs';
import path from 'node:path';
import sharp from 'sharp';
import type { Barattolo } from '../../data/grid-types';
import { pad2 } from '../../lib/format';
import Righello from '../Righello.astro';

interface Props {
  barattoli: Barattolo[];
  title?: string;
  body?: string | string[];
}
const { barattoli, title, body } = Astro.props;

// geometria misurata dallo strumento: letta al build, così lo script non la deve scaricare
// `largo` e `centro`: quanto è largo il vetro e dove sta il suo mezzo (nel ritaglio non è al centro, ed è inclinato),
// senza l'ombra che sfuma nella carta: in larghezza conta solo lui. `piede`: il punto più basso del vetro, per centrare
// il vaso e posarci l'ombra
const geometria = async (m: string) => {
  const cartella = path.join(process.cwd(), 'public', 'barattolo', m);
  const G = JSON.parse(fs.readFileSync(path.join(cartella, 'geometria.json'), 'utf8'));
  const { data, info } = await sharp(path.join(cartella, 'vaso.webp')).ensureAlpha().raw().toBuffer({ resolveWithObject: true });
  let x0 = info.width, x1 = 0, y1 = 0;
  for (let i = 3; i < data.length; i += 4) if (data[i] > 8) { const x = ((i - 3) / 4) % info.width; x0 = Math.min(x0, x); x1 = Math.max(x1, x); y1 = Math.floor((i - 3) / 4 / info.width); }
  const largo = (x1 + 1 - x0) * G.w / info.width, centro = (x0 + x1 + 1) / 2 * G.w / info.width;
  const piede = (y1 + 1) * G.h / info.height;
  return { w: G.w, h: G.h, cx: G.cx, cy: G.cy, ang: G.ang, r: G.r, t0: G.t0, t1: G.t1, e: G.e, piano: G.piano, cima: G.cima, largo, centro, piede };
};
const vasi = [...new Set(barattoli.map(b => b.mockup))];
const dati = {
  mockup: Object.fromEntries(await Promise.all(vasi.map(async m => [m, await geometria(m)]))),
  barattoli: barattoli.map(b => ({
    nome: b.nome, mockup: b.mockup, src: b.etichetta.src, bordo: b.bordo?.src, parola: b.parola?.src, interno: b.interno?.src,
    tipo: b.tipo, dentro: b.dentro, pezzi: b.pezzi,
  })),
};
const primo = barattoli[0].nome;
---

<div class="barattolo" data-barattolo={JSON.stringify(dati)}>
  <canvas class="carta" data-carta aria-hidden="true"></canvas>
  <canvas class="carta" data-ombra aria-hidden="true"></canvas>
  <div class="vetrina">
    <div class="testo">
      {title && <h2 class="titolo titolone" data-lente="inversa">{title}</h2>}
      <div class="parola" data-parola aria-hidden="true"></div>
      {typeof body === 'string' && <div class="body paragrafo"><Paragrafi testo={body} /></div>}
      {Array.isArray(body) && body.map(p => <p class="body paragrafo">{p}</p>)}
    </div>
    <canvas class="tela" data-tela role="img" aria-label={`${primo}: trascina per girare il barattolo`}></canvas>
    {/* in fondo il righello dei barattoli (6/11/2026, scelta di Roberto: al posto della didascalia con ‹ 01/10 ›): il
        segno sopra il quadrato è numero e nome; il nome per gli screen reader sta a parte (aria-live) */}
    <div class="piede">
      <span class="sr-only" data-nome aria-live="polite">{primo}</span>
      {barattoli.length > 1
        ? <Righello voci={barattoli.map(b => b.nome)} attivo={0} segno={`${pad2(1)} · ${primo}`} nome="Barattoli" />
        : <span class="mono" aria-hidden="true">{primo}</span>}
    </div>
  </div>
</div>

<style>
  /* in colonna (la vetrina, a griglia): titolo e sotto la parola della linea, a tutta larghezza; sotto la tela dei
     barattoli, fino al righello. Tutti i vasi al centro (6/11/2026, scelta di Roberto; dal 29/10 il vaso alto andava
     dal titolo al righello). Il bordo dell'etichetta in fondo, subito sopra il righello */
  .barattolo { position: absolute; inset: 0; }
  /* il bordo dell'etichetta in fondo, sotto il barattolo e sopra il righello (scripts/barattolo.ts): la tela del barattolo è
     trasparente fuori dalla sagoma del vaso. Sopra la carta, la tela dell'ombra a terra (stessa misura) */
  .carta { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .vetrina { position: absolute; inset: 0; display: grid; grid-template-rows: auto minmax(0, 1fr) auto; }
  .tela {
    position: relative; z-index: 1;
    grid-row: 2; grid-column: 1; width: 100%;
    /* sale fin quasi in cima alla parola corsiva (alta 22cqi): il vaso, più grande, le passa un poco sopra (6/11/2026, scelta di Roberto) */
    margin-top: -17cqi; height: calc(100% + 17cqi);
    cursor: var(--cursore-aperta);
    /* col dito si gira e si sfoglia solo in orizzontale: il gesto verticale resta allo scroll della pagina */
    touch-action: pan-y;
    user-select: none;
  }
  .tela:active { cursor: var(--cursore-chiusa); }
  /* la parola della linea (Confetture, Sottolio…) sotto il titolo, dritta e a filo a sinistra come lui (6/11/2026,
     scelta di Roberto; prima girata in verticale sul lato, alta 15,5cqi): l'SVG fa da maschera, il colore è quello del
     bordo del barattolo (scripts/barattolo.ts). Le parole troppo lunghe per la cella (Paste e sughi) si stringono */
  .parola {
    width: 100%; height: 22cqi;
    background-color: var(--parola-colore, transparent);
    mask: var(--parola) left center / contain no-repeat;
    opacity: 0;
    transition: background-color 520ms cubic-bezier(.45, 0, .55, 1);
  }
  /* il piede col righello, sotto la fascia del bordo (scripts/barattolo.ts la dipinge sopra di lui) e del suo colore
     (--fascia, dallo script), col righello tutto bianco (7/11/2026, scelta di Roberto). Finché il bordo non c'è, sulla
     carta coi colori di sempre */
  .piede { grid-row: 3; grid-column: 1; padding: var(--pad); position: relative; z-index: 1; transition: background-color 520ms cubic-bezier(.45, 0, .55, 1); }
  .piede[style*='--fascia'] {
    background-color: var(--fascia);
    --righello-segno: var(--bianco); --righello-testo: var(--bianco); --righello-fondo: var(--fascia);
  }
  /* i quadratini prendono il colore della fascia insieme al piede */
  .piede :global(.tacca) { transition: background-color 520ms cubic-bezier(.45, 0, .55, 1); }

  /* sotto il barattolo, e non blocca i gesti */
  .testo {
    grid-row: 1; grid-column: 1;
    display: flex; flex-direction: column; gap: var(--m);
    padding: var(--pad-label) var(--pad) 0;
    pointer-events: none;
  }
</style>
