---
interface Props {
  eyebrow?: string;
  title: string;
  body?: string | string[];
  as?: 'h1' | 'h2' | 'p';
  size?: 's' | 'm' | 'l';
}
const { eyebrow, title, body, as: Tag = 'h2', size = 'm' } = Astro.props;
// occhiello e titolo viaggiano nell'espansione della cella (morph.ts)
// un "_" finale diventa un cursore lampeggiante
const caret = title.endsWith('_');
const text = caret ? title.slice(0, -1) : title;
---

<div class:list={['text', `text--${size}`]}>
  {eyebrow && <p class="eyebrow mono" data-part="eyebrow">{eyebrow}</p>}
  <Tag class="title" data-part="title">{text}{caret && <span class="caret loop" aria-hidden="true">_</span>}</Tag>
  {typeof body === 'string' && <p class="body">{body}</p>}
  {Array.isArray(body) && <ul class="body body--list">{body.map(line => <li>{line}</li>)}</ul>}
</div>

<style>
  .text {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; justify-content: flex-end;
    gap: var(--m);
    padding: var(--pad-label) var(--pad) var(--pad);
  }
  .eyebrow { margin-bottom: auto; }

  .title {
    font-family: var(--font-testo);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.025em;
    /* riquadro stretto sul testo: nell'espansione si scala senza deformarsi (morph.ts) */
    align-self: flex-start;
    max-width: 100%;
  }
  .text--l .title { font-size: clamp(24px, min(8.4cqi, 13cqb), 72px); line-height: 1.02; }
  .text--m .title { font-size: clamp(28px, min(22cqi, 34cqb), 128px); letter-spacing: -0.04em; }
  .text--s .title { font-size: clamp(18px, min(6.4cqi, 13cqb), 40px); }

  .body {
    max-width: 44ch;
    font-size: 14px; line-height: 1.35;
  }
  .body--list { list-style: none; }
  /* casella bassa (es. 2×1 a 1024 o su tablet stretto): il testo sotto si stringe */
  @container (max-height: 180px) { .body { font-size: 12px; line-height: 1.25; } }

  .caret { animation: caret-blink 1.1s steps(1) infinite; }
  @keyframes caret-blink { 50% { opacity: 0; } }
</style>
