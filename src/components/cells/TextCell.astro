---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Paragrafi from '../Paragrafi.astro';
import CodaLink from '../CodaLink.astro';
import type { Cifra } from '../../data/grid-types';

interface Props {
  title: string;
  body?: string | string[];
  as?: 'h1' | 'h2' | 'p';
  size?: 's' | 'm' | 'l';
  /** foto sotto il paragrafo: un carosello che gira da solo (cells.ts), un tocco passa alla dopo; con una foto sola, ferma */
  immagini?: Array<{ image: ImageMetadata; alt: string }>;
  /** le foto si ingrandiscono al clic (scripts/ingrandisci.ts, come le celle media) invece di passare alla dopo */
  ingrandisci?: boolean;
  /** sotto le foto: un altro paragrafo */
  after?: string;
  /** coda in fondo alla cella (es. Visita il sito): CodaLink */
  button?: { label: string; href: string };
  /** numeri in fondo, in riga, divisi da un filo alto quanto loro (9/11/2026, Rob Display: prima sei celle stat) */
  cifre?: Cifra[];
  sizes?: string;
}
const { title, body, as: Tag = 'h2', size = 'm', immagini, ingrandisci, after, button, cifre, sizes } = Astro.props;
const grande = (testo: string) => ingrandisci ? { 'data-ingrandisci': '', tabindex: 0, role: 'button' as const, 'aria-label': `Ingrandisci: ${testo}` } : {};
// un "_" finale diventa un cursore lampeggiante
const caret = title.endsWith('_');
const text = caret ? title.slice(0, -1) : title;
---

<div class:list={['text', `text--${size}`, immagini && 'text--foto']}>
  <Tag class="title">{text}{caret && <span class="caret loop" aria-hidden="true">_</span>}</Tag>
  {typeof body === 'string' && <div class="body paragrafo"><Paragrafi testo={body} /></div>}
  {Array.isArray(body) && <ul class="body paragrafo body--list">{body.map(line => <li>{line}</li>)}</ul>}
  {immagini && (
    <div class:list={['carosello', immagini.length === 1 && 'carosello--fermo']} data-carosello={immagini.length > 1 || undefined}>
      <div class="carosello__nastro">
        {immagini.map(im => (
          <div class="carosello__foto"><Image src={im.image} alt={im.alt} {...grande(im.alt)} widths={[400, 800, 1200, 1600]} sizes={sizes} loading="lazy" decoding="async" /></div>
        ))}
      </div>
    </div>
  )}
  {after && <div class="body paragrafo"><Paragrafi testo={after} /></div>}
  {cifre && (
    <ul class="cifre">
      {cifre.map((c, i) => (
        <>
          {i > 0 && <li class="cifre__filo" aria-hidden="true" />}
          <li class="cifre__voce">
            <span class="cifre__numero" data-countup={c.countUp ? '' : undefined}>{c.value}</span>
            <span class="mono">{c.caption}</span>
          </li>
        </>
      ))}
    </ul>
  )}
  {button && <CodaLink {...button} />}
</div>

<style>
  /* titolo e paragrafo in alto, mai in fondo alla cella (9/11/2026, scelta di Roberto: "da nessuna parte nel sito") */
  .text {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; justify-content: flex-start;
    gap: var(--m);
    padding: var(--pad-label) var(--pad) var(--pad);
  }

  .title {
    font-family: var(--font-testo);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.025em;
    align-self: flex-start;
    max-width: 100%;
  }
  .text--l .title { font-size: clamp(24px, min(8.4cqi, 13cqb), 72px); line-height: 1.02; }
  .text--m .title { font-size: clamp(28px, min(22cqi, 34cqb), 128px); letter-spacing: -0.04em; }
  /* peso dei titoletti (.titoletto, global.css): 600 dal 6/11/2026 */
  .text--s .title { font-size: var(--titoletto); font-weight: 600; }

  .body--list { list-style: none; }

  /* con le foto: titolo e paragrafo in alto, il carosello in tutto lo spazio che resta, a filo della cella
     su tre lati (esce dal margine interno). Mai più basso di poco più di metà della larghezza: se il testo
     cresce, la cella si allunga (scripts/mosaico.ts) invece di schiacciare le foto */
  .carosello { flex: 1 0 0; min-height: 55cqi; margin: var(--m) calc(-1 * var(--pad)) calc(-1 * var(--pad)); }
  /* con un paragrafo sotto: le foto si staccano dal fondo, a filo solo dei lati */
  .carosello:not(:last-child):not(:has(+ .coda-info)) { margin-bottom: var(--m); }
  /* con la coda (Visita il sito) il contenuto le sta sopra */
  .text:has(> .coda-info) { padding-bottom: calc(var(--coda-info) + var(--pad)); }

  /* cifre: in fondo alla cella (come nelle celle stat), in riga, spazi uguali fra numeri e fili (space-between: conta
     il contenuto, non colonne uguali); il filo è alto quanto la voce, numero e didascalia. Sul telefono tre per riga */
  .cifre {
    list-style: none;
    margin-top: auto; padding-top: calc(2 * var(--pad));
    display: flex; justify-content: space-between; gap: var(--pad);
  }
  .cifre__voce { display: flex; flex-direction: column; gap: var(--m); }
  .cifre__numero {
    font-family: var(--font-numeri); font-weight: 500;
    font-size: clamp(32px, 7cqi, 96px);
    line-height: 0.78; letter-spacing: -0.06em;
    font-variant-numeric: tabular-nums;
    margin-left: -0.06em;
  }
  .cifre__filo { border-left: var(--line) solid var(--inchiostro); }
  @container (width < 600px) {
    .cifre { display: grid; grid-template-columns: auto auto auto auto auto; justify-content: space-between; row-gap: var(--pad); }
    .cifre__numero { font-size: 12cqi; }
    .cifre__filo:nth-child(6n) { display: none; }
  }

  .caret { animation: caret-blink 1.1s steps(1) infinite; }
  @keyframes caret-blink { 50% { opacity: 0; } }
</style>
