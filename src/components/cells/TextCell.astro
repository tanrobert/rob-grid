---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Paragrafi from '../Paragrafi.astro';

interface Props {
  title: string;
  body?: string | string[];
  as?: 'h1' | 'h2' | 'p';
  size?: 's' | 'm' | 'l';
  /** foto sotto il paragrafo: un carosello che gira da solo (cells.ts), un tocco passa alla dopo */
  immagini?: Array<{ image: ImageMetadata; alt: string }>;
  sizes?: string;
}
const { title, body, as: Tag = 'h2', size = 'm', immagini, sizes } = Astro.props;
// un "_" finale diventa un cursore lampeggiante
const caret = title.endsWith('_');
const text = caret ? title.slice(0, -1) : title;
---

<div class:list={['text', `text--${size}`, immagini && 'text--foto']}>
  <Tag class="title">{text}{caret && <span class="caret loop" aria-hidden="true">_</span>}</Tag>
  {typeof body === 'string' && <div class="body"><Paragrafi testo={body} /></div>}
  {Array.isArray(body) && <ul class="body body--list">{body.map(line => <li>{line}</li>)}</ul>}
  {immagini && (
    <div class="carosello" data-carosello>
      <div class="nastro">
        {immagini.map(im => (
          <div class="foto"><Image src={im.image} alt={im.alt} widths={[400, 800, 1200]} sizes={sizes} loading="lazy" decoding="async" /></div>
        ))}
      </div>
    </div>
  )}
</div>

<style>
  .text {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; justify-content: flex-end;
    gap: var(--m);
    padding: var(--pad-label) var(--pad) var(--pad);
  }

  .title {
    font-family: var(--font-testo);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.025em;
    align-self: flex-start;
    max-width: 100%;
  }
  .text--l .title { font-size: clamp(24px, min(8.4cqi, 13cqb), 72px); line-height: 1.02; }
  .text--m .title { font-size: clamp(28px, min(22cqi, 34cqb), 128px); letter-spacing: -0.04em; }
  .text--s .title { font-size: var(--titoletto); }

  .body {
    max-width: 44ch;
    font-size: var(--paragrafo); line-height: 1.35;
  }
  .body--list { list-style: none; }

  /* con le foto: titolo e paragrafo in alto, il carosello in tutto lo spazio che resta, a filo della cella
     su tre lati (esce dal margine interno). Mai più basso di poco più di metà della larghezza: se il testo
     cresce, la cella si allunga (scripts/mosaico.ts) invece di schiacciare le foto */
  .text--foto { justify-content: flex-start; }
  .carosello {
    flex: 1 0 0; min-height: 55cqi; margin: var(--m) calc(-1 * var(--pad)) calc(-1 * var(--pad));
    position: relative; overflow: clip; cursor: pointer;
  }
  /* le foto in fila, attaccate, una per volta: cells.ts sposta il nastro di una foto con `--i` */
  .nastro {
    position: absolute; inset: 0;
    display: flex;
    translate: calc(var(--i, 0) * -100%) 0;
    transition: translate 700ms cubic-bezier(0.65, 0, 0.35, 1);
  }
  .nastro.is-salto { transition: none; }
  .foto { flex: 0 0 100%; position: relative; }
  .foto img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  .caret { animation: caret-blink 1.1s steps(1) infinite; }
  @keyframes caret-blink { 50% { opacity: 0; } }
</style>
