---
import { pad2 } from '../../lib/format';

interface Props {
  title: string;
  items: Array<string | { label: string; href: string }>;
}
const { title, items } = Astro.props;
---

<div class="list">
  <h2 class="mono">{title} <span>/ {pad2(items.length)}</span></h2>
  <ol>
    {items.map((item, i) => {
      const n = <span class="mono">{pad2(i + 1)}</span>;
      return typeof item === 'string'
        ? <li>{n}{item}</li>
        : <li><a href={item.href}>{n}{item.label}</a></li>;
    })}
  </ol>
</div>

<style>
  .list {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; justify-content: space-between;
    padding: var(--pad-label) var(--pad) var(--pad);
  }
  h2 { font-weight: 400; }
  ol {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: var(--line) solid currentColor;
  }
  li {
    display: flex; align-items: baseline; gap: 8px;
    padding: 6px 0 5px;
    border-bottom: var(--line) solid currentColor;
    font-size: clamp(12px, min(3.4cqi, 7cqb), 20px);
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  li .mono { font-size: 9px; }
  li a { display: flex; align-items: baseline; gap: 8px; width: 100%; min-width: 0; }
  @media (hover: hover) and (pointer: fine) {
    li a { transition: opacity 200ms ease; }
    ol:has(a:hover) a:not(:hover) { opacity: 0.35; }
  }
  @container (max-width: 300px) { ol { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
