---
import SvgAsset from '../SvgAsset.astro';
import { svgs, type SvgName } from '../../data/svgs';

interface Props {
  svg: SvgName;
  fit?: 'contain' | 'bleed';
  /** la cella è l'interruttore della luce (scripts/ink.ts): premuta, rosso e bianco del sito si scambiano */
  ink?: boolean;
}
const { svg, fit = 'contain', ink = false } = Astro.props;
---

{ink ? (
  <button class:list={['svg', `svg--${fit}`, 'svg--switch']} type="button" role="switch" aria-checked="true" aria-label="Luce" title="Spegni la luce" data-ink>
    <SvgAsset name={svg} />
  </button>
) : (
  <div class:list={['svg', `svg--${fit}`]} role="img" aria-label={svgs[svg].label}>
    <SvgAsset name={svg} />
  </div>
)}

<style>
  .svg {
    position: absolute; inset: 0;
    display: grid; place-items: center;
    padding: var(--pad);
  }
  .svg :global(svg) { width: 100%; height: 100%; }
  .svg--bleed { padding: 0; }
  /* reset del bottone uno per uno: `all: unset` toglierebbe anche l'animazione d'ingresso (.is-intro .cell > *) */
  .svg--switch {
    appearance: none; background: none; border: 0; margin: 0;
    color: inherit; font: inherit;
    cursor: pointer;
  }
</style>
