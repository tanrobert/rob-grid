---
import SvgAsset from '../SvgAsset.astro';
import type { SvgName } from '../../data/grid-types';

interface Props {
  svg: SvgName;
  fit?: 'contain' | 'bleed';
}
const { svg, fit = 'contain' } = Astro.props;
const names: Record<SvgName, string> = { 'logo-r': 'Logo R', 'roberto': 'Roberto', 'logo-completo': 'Roberto — logo completo' };
---

<div class:list={['svg', `svg--${fit}`]} role="img" aria-label={names[svg]}>
  <SvgAsset name={svg} />
</div>

<style>
  .svg {
    position: absolute; inset: 0;
    display: grid; place-items: center;
    padding: var(--pad);
  }
  .svg :global(svg) { width: 100%; height: 100%; }
  .svg--bleed { padding: 0; }
</style>
