---
import SvgAsset from '../SvgAsset.astro';
import { svgs, type SvgName } from '../../data/svgs';

interface Props {
  svg: SvgName;
  fit?: 'contain' | 'bleed';
  /** la cella è il tasto Riordina del tavolo (scripts/tavolo): premuta, le celle tornano al loro posto */
  riordina?: boolean;
}
const { svg, fit = 'contain', riordina = false } = Astro.props;
---

{riordina ? (
  <button class:list={['svg', `svg--${fit}`, 'svg--tasto']} type="button" aria-label="Riordina il tavolo" title="Riordina" data-riordina>
    <SvgAsset name={svg} />
  </button>
) : (
  <div class:list={['svg', `svg--${fit}`]} role="img" aria-label={svgs[svg].label}>
    <SvgAsset name={svg} />
  </div>
)}

<style>
  .svg {
    position: absolute; inset: 0;
    display: grid; place-items: center;
    padding: var(--pad);
  }
  .svg :global(svg) { width: 100%; height: 100%; }
  .svg--bleed { padding: 0; }
  /* reset del bottone uno per uno: `all: unset` toglierebbe anche l'animazione d'ingresso (.is-intro .cell > *) */
  .svg--tasto {
    appearance: none; background: none; border: 0; margin: 0;
    font: inherit;
    /* la R del tavolo è rossa sul sito nero */
    color: var(--rosso);
  }
</style>
