---
import SvgAsset from '../SvgAsset.astro';
import { svgs, type SvgName } from '../../data/svgs';

interface Props {
  svg: SvgName;
  fit?: 'contain' | 'bleed';
}
const { svg, fit = 'contain' } = Astro.props;
---

<div class:list={['svg', `svg--${fit}`]} role="img" aria-label={svgs[svg].label}>
  <SvgAsset name={svg} />
</div>

<style>
  .svg {
    position: absolute; inset: 0;
    display: grid; place-items: center;
    padding: var(--pad);
  }
  .svg :global(svg) { width: 100%; height: 100%; }
  .svg--bleed { padding: 0; }
</style>
