---
// Una cella divisa in riquadri da un filo (G&A: i quattro obiettivi del restyling, dalla tavola 4), ognuno con un
// titoletto e un paragrafo in alto, sotto l'icona, come le celle di testo (dal 9/11/2026; prima in fondo). In riga quando la cella è larga, due per riga su una
// cella media (2×2), uno sotto l'altro su una stretta e sempre sul telefono (4/11/2026, scelta di Roberto). I riquadri
// si dividono la cella in parti uguali (12×3, tablet 8×8, telefono 4×10: sul telefono l'icona e il testo con poca aria in mezzo, come sul computer,
// 5/11/2026; con 4×16 erano quadrati alti il doppio del testo). Righe `1fr`, che non scendono sotto il contenuto: se un
// testo non ci sta, la griglia esce dalla cella e la cella si allunga (scripts/mosaico.ts).
// `icona` (5/11/2026, scelta di Roberto): un disegno a fil di linea rossa in alto nel riquadro, decorativo. Tutte alte 100
// unità, così hanno la stessa altezza; il filo resta di 1px a ogni misura (non-scaling-stroke).
// Col mouse sul riquadro l'icona fa la sua piccola animazione e torna com'era (6/11/2026, idea di Roberto; scripts/punti.ts):
// i pezzi che si muovono hanno un attributo `data-`, quelli che escono stanno in un gruppo ritagliato (`clipPath`).
// Senza JavaScript, col dito o con riduci movimento le icone stanno ferme.
import Paragrafi from '../Paragrafi.astro';

type Icona = 'frecce' | 'cerchio-quadrato' | 'quadrati' | 'mirino';
interface Props {
  punti: Array<{ title: string; body: string; icona?: Icona }>;
}
const { punti } = Astro.props;

/** larghezza del disegno (alto 100) */
const LARGO: Record<Icona, number> = { frecce: 100, 'cerchio-quadrato': 150, quadrati: 100, mirino: 100 };
// id dei ritagli: unici anche con più pagine nello stesso documento (i fogli)
const uid = Math.random().toString(36).slice(2, 8);
---

<div class="punti" style={`--n: ${punti.length}`}>
  {punti.map((p, i) => {
    const ritaglio = `punti-${uid}-${i}`;
    return (
      <div class="punto">
        {p.icona && (
          <svg class="punto__icona" data-icona={p.icona} viewBox={`0 0 ${LARGO[p.icona]} 100`} style={`aspect-ratio: ${LARGO[p.icona]} / 100`} aria-hidden="true">
            {/* un quadrato e dentro una freccia (la metà destra della doppia freccia di prima): la linea, ferma, va da un
                lato all'altro; la punta (le oblique toccano i lati di sopra e di sotto) esce a destra e rientra da sinistra */}
            {p.icona === 'frecce' && (
              <>
                <clipPath id={ritaglio}><rect width="100" height="100" /></clipPath>
                <rect width="100" height="100" />
                <line x1="0" y1="50" x2="100" y2="50" />
                <g clip-path={`url(#${ritaglio})`}><path data-freccia d="M20 0L70 50L20 100" /></g>
              </>
            )}
            {/* un cerchio e un quadrato che condividono il diametro: si scambiano la forma (rx) e tornano */}
            {p.icona === 'cerchio-quadrato' && (
              <>
                <rect data-cerchio width="100" height="100" rx="50" />
                <rect data-quadrato x="50" width="100" height="100" />
              </>
            )}
            {/* quattro quadrati: in quello in basso a destra si tracciano due linee, poi la griglia ingrandisce quel
                quadrato fino a tutto il riquadro, che torna così com'era. Il bordo resta fermo */}
            {p.icona === 'quadrati' && (
              <>
                <clipPath id={ritaglio}><rect width="100" height="100" /></clipPath>
                <rect width="100" height="100" />
                <g clip-path={`url(#${ritaglio})`}>
                  <g data-zoom>
                    <line x1="50" y1="0" x2="50" y2="100" />
                    <line x1="0" y1="50" x2="100" y2="50" />
                    <line data-traccia="y2 100" x1="75" y1="50" x2="75" y2="50" />
                    <line data-traccia="x2 100" x1="50" y1="75" x2="50" y2="75" />
                  </g>
                </g>
              </>
            )}
            {/* mirino: gira di 90°, poi le due linee si cancellano da un capo all'altro e si ritracciano.
                data-ritraccia: l'asse lungo cui corre la linea */}
            {p.icona === 'mirino' && (
              <g data-gira>
                <circle cx="50" cy="50" r="50" />
                <line data-ritraccia="y" x1="50" y1="0" x2="50" y2="100" />
                <line data-ritraccia="x" x1="0" y1="50" x2="100" y2="50" />
              </g>
            )}
          </svg>
        )}
        <h2 class="titoletto">{p.title}</h2>
        <div class="paragrafo"><Paragrafi testo={p.body} /></div>
      </div>
    );
  })}
</div>
<style>
  /* la cella è il contenitore (global.css, .cell): una colonna, poi due, poi tutti in riga */
  .punti {
    position: absolute; inset: 0;
    display: grid; grid-template-columns: minmax(0, 1fr); grid-auto-rows: 1fr;
  }
  /* in alto l'icona e subito sotto il testo (9/11/2026, scelta di Roberto: titoli e paragrafi mai in fondo alla cella) */
  .punto {
    display: flex; flex-direction: column; justify-content: flex-start; gap: var(--m);
    padding: var(--pad-label) var(--pad) var(--pad);
  }
  .punto__icona {
    height: calc(var(--quadretto) * 3); width: auto; align-self: flex-start; margin-bottom: var(--pad); flex: none; overflow: visible;
    fill: none; stroke: var(--rosso); stroke-width: var(--line);
  }
  .punto__icona * { vector-effect: non-scaling-stroke; }
  /* i fili tra i riquadri: bordi (agganciati ai pixel reali), mai sul lato della cella, che ha già il suo */
  .punto + .punto { border-top: var(--line) solid var(--inchiostro); }
  /* sul telefono (griglia a 4 colonne, sotto 600px: lib/grid.ts) sempre in colonna, anche se la cella è larga 480 e più */
  @media (min-width: 600px) {
    @container (min-width: 480px) {
      .punti { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .punto + .punto { border-top: 0; }
      .punto:nth-child(even) { border-left: var(--line) solid var(--inchiostro); }
      .punto:nth-child(n + 3) { border-top: var(--line) solid var(--inchiostro); }
    }
    @container (min-width: 900px) {
      .punti { grid-template-columns: repeat(var(--n), minmax(0, 1fr)); }
      .punto:nth-child(n + 3) { border-top: 0; }
      .punto + .punto { border-left: var(--line) solid var(--inchiostro); }
    }
  }
</style>
