---
// Recapiti come cella (il footer di prima, ridotto ai dati), sul tavolo, in fondo ai fogli e nella 404:
// email e luogo in alto, P.IVA, informativa, anno e versione in basso. Sul tavolo solo P.IVA e informativa
// (`piede: 'legale'`, 10/11/2026): anno e versione stanno nella striscia in basso a sinistra (Tavolo.astro)
import { site } from '../../data/site';
import { legale, firma } from '../../data/piede';

interface Props {
  piede?: 'tutto' | 'legale';
}
const { piede = 'tutto' } = Astro.props;
const [piva, privacy] = legale;
const [anno, versione] = firma;
---

<div class="contatti">
  <ul class="contatti__dati">
    <li><a href={`mailto:${site.email}`} class="link-peso">{site.email}</a></li>
    <li>{site.place}</li>
  </ul>
  <div class="contatti__piede mono">
    <p><span>{piva}</span><span>{privacy}</span></p>
    {piede === 'tutto' && <p><span>{anno}</span><span>{versione}</span></p>}
  </div>
</div>

<style>
  .contatti {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; justify-content: space-between; gap: var(--m);
    padding: var(--pad-label) var(--pad) var(--pad);
  }
  .contatti__dati { list-style: none; display: flex; flex-direction: column; gap: 4px; }
  .contatti__dati li {
    font-size: clamp(14px, 6cqi, 22px);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }
  .contatti__piede { display: flex; flex-direction: column; gap: 4px; }
  /* a sinistra e a destra, e se non ci stanno il testo di destra va a capo allineato a destra */
  .contatti__piede p { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0 var(--m); }
  .contatti__piede span:last-child { margin-left: auto; text-align: right; }
</style>
