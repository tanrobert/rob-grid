---
// Mano col telefono (tools/telefono-mockup.py → public/telefono: foto scontornata con lo schermo bucato e geometria) con
// una registrazione dello schermo che scorre dentro: il video, già messo in prospettiva dallo stesso strumento, sta
// sotto la foto, mascherato con la sagoma dello schermo. Titolo grande in alto, il telefono ci sale sopra.
// Video come la cella media: .webm accanto all'.mp4 se c'è, fermo fuori vista e con riduci movimento (cells.ts),
// fotogramma .webp accanto come poster.
import Paragrafi from '../Paragrafi.astro';
import fs from 'node:fs';
import path from 'node:path';
import type { ImageMetadata } from 'astro';

interface Props {
  video: string;
  alt: string;
  title?: string;
  body?: string | string[];
  logo?: ImageMetadata;
  logoAlt?: string;
}
const { video, alt, title, body, logo, logoAlt } = Astro.props;

const pubblico = (f: string) => fs.existsSync(path.join(process.cwd(), 'public', f));
const G = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'public', 'telefono', 'geometria.json'), 'utf8'));
const webm = video.replace(/\.mp4$/, '.webm');
const poster = video.replace(/\.mp4$/, '.webp');
const schermo = `--x: ${G.left}%; --y: ${G.top}%; --w: ${G.width}%; --h: ${G.height}%; --rapporto: ${G.rapporto}`;
---

<div class="telefono">
  {(title || body) && (
    <div class="testo">
      {title && <h2 class="titolo titolone" data-lente="inversa">{title}</h2>}
      {typeof body === 'string' && <div class="body paragrafo"><Paragrafi testo={body} /></div>}
      {Array.isArray(body) && body.map(p => <p class="body paragrafo">{p}</p>)}
    </div>
  )}
  <div class="mano" style={schermo} data-intero>
    <video data-autoplay muted loop playsinline preload="none" poster={pubblico(poster) ? poster : undefined} aria-label={alt}>
      {webm !== video && pubblico(webm) && <source src={webm} type='video/webm; codecs="av01.0.05M.08"' />}
      <source src={video} type="video/mp4" />
    </video>
    <img src="/telefono/mano.webp" alt="" width="1100" height="1966" loading="lazy" decoding="async" />
  </div>
  {logo && <img class="logo" src={logo.src} alt={logoAlt ?? ''} width={logo.width} height={logo.height} loading="lazy" decoding="async" />}
</div>
<style>
  /* in colonna: titolo e paragrafo in alto, sotto mano e telefono. Senza paragrafo salgono sull'ultima riga del
     titolo fino a metà (scelta di Roberto del 29/10/2026) */
  .telefono {
    position: absolute; inset: 0;
    display: flex; flex-direction: column;
    /* un quadretto fra il testo e il telefono; il resto lo decide il mosaico (la cella cresce, data-intero) */
    gap: var(--pad);
  }
  .testo {
    display: flex; flex-direction: column; gap: var(--m);
    padding: var(--pad-label) var(--pad) 0;
  }
  .titolo:last-child {
    /* solo titolo: la mano sale fin quasi a metà dell'ultima riga */
    margin-bottom: -0.43em;
  }
  /* mano e telefono posati sul lato basso (il polso esce dalla cella), sotto il testo, centrati e alti 95cqi
     (6/11/2026, scelta di Roberto: prima riempivano lo spazio che restava, spostati a destra per il logo).
     data-intero: se il testo li spinge fuori, la cella cresce (scripts/mosaico.ts) invece di schiacciarli */
  .mano {
    position: relative; z-index: 1;
    flex: none; height: 95cqi; margin-top: auto; align-self: center;
    aspect-ratio: var(--rapporto);
  }
  .mano video {
    position: absolute; left: var(--x); top: var(--y); width: var(--w); height: var(--h);
    object-fit: fill;
    /* la sagoma dello schermo con gli angoli tondi: il quadrilatero del video ha le punte vive */
    mask: url('/telefono/schermo.png') 0 0 / 100% 100% no-repeat;
  }
  .mano img { position: relative; display: block; width: 100%; height: 100%; }
  /* il logo del cliente in basso a sinistra, sopra la mano */
  .logo { position: absolute; left: var(--pad); bottom: var(--pad); z-index: 2; width: 32%; height: auto; }
</style>
