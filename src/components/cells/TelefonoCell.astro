---
// Mano col telefono (tools/telefono-mockup.py → public/telefono: foto scontornata con lo schermo bucato e geometria) con
// una registrazione dello schermo che scorre dentro: il video, già messo in prospettiva dallo stesso strumento, sta
// sotto la foto, mascherato con la sagoma dello schermo. Testo in alto a sinistra, sopra il telefono (può coprirlo).
// Video come la cella media: .webm accanto all'.mp4 se c'è, fermo fuori vista e con riduci movimento (cells.ts),
// fotogramma .webp accanto come poster.
import fs from 'node:fs';
import path from 'node:path';
import type { ImageMetadata } from 'astro';

interface Props {
  video: string;
  alt: string;
  eyebrow?: string;
  title?: string;
  body?: string | string[];
  logo?: ImageMetadata;
  logoAlt?: string;
}
const { video, alt, eyebrow, title, body, logo, logoAlt } = Astro.props;

const pubblico = (f: string) => fs.existsSync(path.join(process.cwd(), 'public', f));
const G = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'public', 'telefono', 'geometria.json'), 'utf8'));
const webm = video.replace(/\.mp4$/, '.webm');
const poster = video.replace(/\.mp4$/, '.webp');
const schermo = `--x: ${G.left}%; --y: ${G.top}%; --w: ${G.width}%; --h: ${G.height}%; --rapporto: ${G.rapporto}`;
---

<div class="telefono">
  <div class="mano" style={schermo}>
    <video data-autoplay muted loop playsinline preload="none" poster={pubblico(poster) ? poster : undefined} aria-label={alt}>
      {webm !== video && pubblico(webm) && <source src={webm} type='video/webm; codecs="av01.0.05M.08"' />}
      <source src={video} type="video/mp4" />
    </video>
    <img src="/telefono/mano.webp" alt="" width="1100" height="1966" loading="lazy" decoding="async" />
  </div>
  {logo && <img class="logo" src={logo.src} alt={logoAlt ?? ''} width={logo.width} height={logo.height} loading="lazy" decoding="async" />}
  {(eyebrow || title || body) && (
    <div class="testo">
      {eyebrow && <p class="eyebrow mono">{eyebrow}</p>}
      {title && <h2 class="titolo">{title}</h2>}
      {typeof body === 'string' && <p class="body">{body}</p>}
      {Array.isArray(body) && body.map(p => <p class="body">{p}</p>)}
    </div>
  )}
</div>
<style>
  .telefono { position: absolute; inset: 0; }
  /* mano e telefono centrati, posati sul lato basso (il polso esce dalla cella), con un poco d'aria sopra */
  .mano {
    position: absolute; left: 50%; bottom: 0; translate: -50% 0;
    height: calc(100cqh - var(--aria-mockup)); aspect-ratio: var(--rapporto);
  }
  .mano video {
    position: absolute; left: var(--x); top: var(--y); width: var(--w); height: var(--h);
    object-fit: fill;
    /* la sagoma dello schermo con gli angoli tondi: il quadrilatero del video ha le punte vive */
    mask: url('/telefono/schermo.png') 0 0 / 100% 100% no-repeat;
  }
  .mano img { position: relative; display: block; width: 100%; height: 100%; }
  /* il logo del cliente in basso a sinistra, sopra la mano */
  .logo { position: absolute; left: var(--pad); bottom: var(--pad); z-index: 1; width: 48%; height: auto; }
  /* sopra il telefono, ma non lo blocca */
  .testo {
    position: absolute; top: 0; left: 0; z-index: 1;
    display: flex; flex-direction: column; gap: var(--m);
    padding: var(--pad-label) var(--pad) 0;
    max-width: min(80%, 42ch);
    pointer-events: none;
  }
  .titolo {
    font-family: var(--font-testo); font-weight: 500; line-height: 1.02; letter-spacing: -0.025em;
    font-size: clamp(20px, 6cqi, 36px);
  }
  .body { font-size: 14px; line-height: 1.35; }
</style>
