---
// Cella 02 delle pagine progetto quando il progetto ha una foto di contesto (`contesto` nell'index.md): titolo del
// progetto (h1) e descrizione in alto, come la cella di testo piccola, e sotto la foto a tutta larghezza, a filo dei
// lati e del fondo della cella. Con `fondo` (immagini piccole, es. un vecchio banner): la foto intera, alla sua misura
// (mai ingrandita), al centro di un campo del suo colore. Cella orizzontale (6/11/2026, G&A): il testo in una metà,
// la foto o il campo nell'altra, come il ridisegno.
// `didascalia` (6/11/2026, scelta di Roberto: "Logo originale", per dire chiaro che è il logo di prima): una riga mono
// in alto a sinistra sulla foto o sul campo (sopra il logo, mai sotto: scelta di Roberto), a --pad dai bordi; in carta, d'inchiostro sui campi chiari.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Paragrafi from '../Paragrafi.astro';

interface Props {
  title: string;
  body?: string;
  image: ImageMetadata;
  alt: string;
  fondo?: string;
  didascalia?: string;
  sizes: string;
}
const { title, body, image, alt, fondo, didascalia, sizes } = Astro.props;
// campo chiaro (luminanza relativa WCAG sopra 0,4): didascalia d'inchiostro, se no in carta
const lin = (c: number) => (c /= 255) <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
const chiaro = !!fondo && (([r, g, b]) => 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b))(fondo.slice(1).match(/../g)!.map(h => parseInt(h, 16))) > 0.4;
---

<div class:list={['contesto', fondo && 'contesto--fondo']}>
  <div class="testo">
    <h1 class="titoletto">{title}</h1>
    {body && <div class="body paragrafo"><Paragrafi testo={body} /></div>}
  </div>
  {fondo ? (
    <div class="foto foto--fondo" style={{ background: fondo }} data-intero>
      <Image src={image} alt={alt} loading="eager" decoding="async" class:list={[image.format === 'svg' && 'vettoriale']} />
      {didascalia && <p class:list={['didascalia mono', chiaro && 'didascalia--scura']}>{didascalia}</p>}
    </div>
  ) : (
    <div class="foto">
      <Image src={image} alt={alt} widths={[600, 1000, 1500]} sizes={sizes} loading="eager" decoding="async" />
      {didascalia && <p class="didascalia mono">{didascalia}</p>}
    </div>
  )}
</div>

<style>
  .contesto { position: absolute; inset: 0; display: grid; grid-template: auto minmax(0, 1fr) / minmax(0, 1fr); }
  /* come TextCell size 's' */
  .testo { display: flex; flex-direction: column; gap: var(--m); padding: var(--pad-label) var(--pad) var(--pad); }
  .foto { position: relative; overflow: hidden; }
  .foto img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .didascalia {
    position: absolute; left: var(--pad); top: var(--pad); right: var(--pad); margin: 0;
    line-height: var(--riga-label); color: var(--chiaro);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .didascalia--scura { color: var(--inchiostro); }

  /* campo colorato: tutto lo spazio sotto il testo (la cella è alta quanto la hero, pages/progetti/[slug]), mai meno di
     mezza cella; la foto alla sua misura, più piccola solo se non ci sta. Se il campo non ci sta esce dal fondo e
     scripts/mosaico.ts (data-intero) allunga la cella */
  .contesto--fondo { grid-template-rows: auto minmax(50cqi, 1fr); }
  /* il campo è al massimo quadrato, posato sul fondo della cella: se avanza spazio resta carta sotto il testo (G&A) */
  /* riga e colonna fisse sul campo: con `auto` la traccia prende la misura della foto e max-height: 100% non la
     riduce più (sul telefono il banner usciva dal campo, tagliato) */
  .foto--fondo { display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); place-items: center; padding: var(--pad); align-self: end; height: 100%; max-height: 100cqi; }
  .foto--fondo img { position: static; width: auto; height: auto; max-width: 100%; max-height: 100%; object-fit: contain; }
  /* un disegno SVG non ha una sua misura: piccolo, al 60% del campo */
  .foto--fondo img.vettoriale { width: 60%; }

  /* cella orizzontale (almeno il doppio larga che alta): testo a sinistra, foto o campo a destra, metà e metà (Roberto:
     "più spazio al testo, meno alla forma"), staccati da un filo.
     Il campo prende tutta l'altezza; la foto al centro, alla sua misura o più piccola, il disegno alto il 60% del campo */
  @container (min-aspect-ratio: 2 / 1) {
    .contesto, .contesto--fondo { grid-template: minmax(0, 1fr) / minmax(0, 1fr) minmax(0, 1fr); }
    .foto { border-left: var(--line) solid var(--inchiostro); }
    .foto--fondo { display: block; align-self: stretch; max-height: none; }
    .foto--fondo img {
      position: absolute; inset: 0; margin: auto;
      max-width: calc(100% - var(--pad) * 2); max-height: calc(100% - var(--pad) * 2);
    }
    .foto--fondo img.vettoriale { width: auto; height: 60%; }
  }
</style>
