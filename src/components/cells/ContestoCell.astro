---
// Cella 02 delle pagine progetto quando il progetto ha una foto di contesto (`contesto` nell'index.md): titolo del
// progetto (h1) e descrizione in alto, come la cella di testo piccola, e sotto la foto a tutta larghezza, a filo dei
// lati e del fondo della cella.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Paragrafi from '../Paragrafi.astro';

interface Props {
  title: string;
  body?: string;
  image: ImageMetadata;
  alt: string;
  sizes: string;
}
const { title, body, image, alt, sizes } = Astro.props;
---

<div class="contesto">
  <div class="testo">
    <h1 class="titoletto">{title}</h1>
    {body && <div class="body paragrafo"><Paragrafi testo={body} /></div>}
  </div>
  <div class="foto">
    <Image src={image} alt={alt} widths={[600, 1000, 1500]} sizes={sizes} loading="eager" decoding="async" />
  </div>
</div>

<style>
  .contesto { position: absolute; inset: 0; display: grid; grid-template: auto minmax(0, 1fr) / minmax(0, 1fr); }
  /* come TextCell size 's' */
  .testo { display: flex; flex-direction: column; gap: var(--m); padding: var(--pad-label) var(--pad) var(--pad); }
  .foto { position: relative; overflow: hidden; }
  .foto img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
</style>
