---
interface Props {
  /** il testo che scorre, scritto col font del logotipo (.logotipo) */
  text: string;
  speed?: number;
  /** nastro orizzontale girato di 90° in una cella verticale */
  ruotato?: boolean;
}
const { text, speed = 40, ruotato = false } = Astro.props;
// due metà identiche di tre copie: la traccia scorre del 50% e riparte senza stacco
const copies = [0, 1, 2];
---

<div class:list={['marquee', ruotato && 'marquee--ruotato']} aria-hidden="true">
  <div class="track loop" style={`--speed:${speed}s`}>
    {[0, 1].map(() => (
      <div class="half">
        {copies.map(() => <span class="item logotipo">{text}</span>)}
      </div>
    ))}
  </div>
</div>
<span class="sr-only">{text}</span>

<style>
  .marquee {
    position: absolute; inset: 0;
    display: flex; align-items: center;
    overflow: hidden;
  }
  .track {
    display: flex; width: max-content;
    animation: marquee var(--speed) linear infinite;
  }
  .half { display: flex; }
  @keyframes marquee {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-50%, 0, 0); }
  }

  /* testo: maiuscole alte quanto la cella meno il margine. Riquadro senza rifilo (i margini delle lettere fanno
     parte del ritmo) e dopo ogni copia uno spazio, così tra "·" e la R c'è lo stesso stacco che c'è dentro il testo.
     Sul tavolo non più grandi di ROBERTO nella cella del nome (--corpo-logotipo, Tavolo.astro): riquadro alto
     quanto le maiuscole, così il nastro lo centra nella striscia */
  .item {
    --h: calc(100cqb - 2 * var(--pad));
    font-size: min(var(--h) / var(--maiuscole), var(--corpo-logotipo, 100vmax));
    margin-inline: 0 0.22em;
  }

  /* ── Ruotato: il nastro orizzontale girato di 90° dentro una cella verticale. Il riquadro ha i lati
     scambiati (largo quanto la cella è alta) e ruota attorno al centro; il testo è alto quanto la cella
     è larga, meno il margine (100cqi = larghezza della cella, il container più vicino) ── */
  .marquee--ruotato {
    inset: auto; top: 50%; left: 50%;
    width: 100cqb; height: 100cqi;
    translate: -50% -50%;
    rotate: -90deg;
  }
  .marquee--ruotato .item { --h: calc(100cqi - 2 * var(--pad)); }
</style>
