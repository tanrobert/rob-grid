---
import type { Tone } from '../data/grid-types';
import Close from '../assets/close.svg';

interface Props {
  /** href della cella di origine: deve coincidere per far funzionare l'espansione */
  from: string;
  label: string;
  tone?: Tone;
}
const { from, label, tone = 'paper' } = Astro.props;
---

<header
  class:list={['cell', 'hero', tone === 'red' && 'cell--red']}
  data-hero={from}
>
  <span class="cell__label mono" aria-hidden="true"><span>00</span><span>{label}</span></span>
  <a href="/" class="cell__go" aria-label="Chiudi e torna alla griglia" data-close data-part="go"><span><Close /></span></a>
  <slot />
</header>

<style>
  .hero {
    height: clamp(420px, 72svh, 900px);
    margin-bottom: var(--gap);
  }
</style>
