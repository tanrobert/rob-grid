---
// Casella di chiusura: sempre l'ultima, larga quanto il foglio.
// Dentro: logo largo due colonne della griglia, poi tre zone distribuite in base al testo.
import SvgAsset from './SvgAsset.astro';
import { siteVersion } from '../lib/version';

const EMAIL = 'info@robertotanasi.it';
const PIVA = '03362040598';
const PLACE = 'Itri (LT), Italia';

const pages = [
  { label: 'Indice', href: '/' },
  { label: 'Archivio', href: '/archivio' },
  { label: 'Info', href: '/info' },
];
const year = new Date().getFullYear();
---

<footer class="foot cell--red">
  <span class="cell__label mono" aria-hidden="true"><span>Footer</span></span>

  <div class="foot__cols">
    <a href="/" class="foot__logo" aria-label="Roberto — Homepage">
      <SvgAsset name="roberto" />
    </a>

    <div class="foot__zones">
      <nav class="foot__zone" aria-label="Pagine">
        <ul>
          {pages.map(p => <li><a href={p.href} class="foot__link"><span class="foot__run">{p.label}<span class="foot__copy" aria-hidden="true">{p.label}</span></span></a></li>)}
        </ul>
      </nav>

      <div class="foot__zone">
        <ul>
          <li><a href={`mailto:${EMAIL}`} class="foot__link"><span class="foot__run">{EMAIL}<span class="foot__copy" aria-hidden="true">{EMAIL}</span></span></a></li>
          <li>{PLACE}</li>
        </ul>
      </div>

      <div class="foot__zone">
        <p>Informativa Privacy</p>
        <p class="mono">P.IVA {PIVA}</p>
      </div>
    </div>
  </div>

  <div class="foot__bar mono">
    <span>© {year} Roberto</span>
    <span>Portfolio modulare v.{siteVersion}</span>
  </div>
</footer>

<style>
  .foot {
    position: relative;
    display: flex; flex-direction: column; gap: calc(var(--pad) * 2);
    margin-top: var(--gap);
    padding: var(--pad-label) 0 calc(var(--pad) + env(safe-area-inset-bottom));
  }

  /* logo largo due colonne della griglia; le tre zone prendono la larghezza del loro testo
     e lo spazio libero si divide in parti uguali tra logo, zone e bordo destro */
  .foot__cols {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start;
    gap: calc(var(--pad) * 2);
    padding-inline: var(--pad);
  }
  .foot__logo { flex: none; width: calc(4 * var(--u) + 3 * var(--gap) - 2 * var(--pad)); }
  .foot__logo :global(svg) { width: 100%; height: auto; }

  /* desktop: le zone sono fratelli diretti del logo nella stessa riga */
  .foot__zones { display: contents; }
  .foot__zone { flex: none; }
  /* tablet: riga propria sotto il logo, stessa distribuzione */
  @media (max-width: 1023px) {
    .foot__zones { display: flex; flex-basis: 100%; justify-content: space-between; gap: calc(var(--pad) * 2); }
  }
  /* mobile: una sotto l'altra */
  @media (max-width: 599px) { .foot__zones { flex-direction: column; } }

  .foot__zone { display: flex; flex-direction: column; gap: var(--m); }
  .foot__zone ul { list-style: none; display: flex; flex-direction: column; gap: 4px; }
  .foot__zone li, .foot__zone p:not(.mono) {
    font-size: clamp(14px, 1.2vw, 18px);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .foot__bar {
    display: flex; justify-content: space-between; gap: var(--pad);
    margin-inline: var(--pad);
  }
  /* su schermi stretti il testo di destra va a capo restando allineato a destra */
  .foot__bar span:last-child { text-align: right; }

  /* link a nastro: al passaggio il testo esce a destra e la sua copia (subito a sinistra, fuori dal link) entra
     al suo posto. A fine corsa la copia sta esattamente dove stava il testo: togliere la classe non si vede.
     La classe la mette lo script qui sotto, così il giro arriva sempre in fondo anche se il mouse esce prima */
  .foot__link { display: inline-block; vertical-align: top; overflow: clip; }
  .foot__run { --nastro: calc(100% + 0.4em); display: inline-block; position: relative; }
  .foot__copy { position: absolute; top: 0; left: calc(var(--nastro) * -1); width: 100%; user-select: none; }
  .foot__link.is-run .foot__run { animation: foot-nastro 640ms cubic-bezier(0.65, 0, 0.35, 1); }
  @keyframes foot-nastro { to { transform: translateX(var(--nastro)); } }

  @media (hover: hover) and (pointer: fine) {
    /* hover in bianco puro: resta nella bicromia, niente rosa da trasparenza */
    .foot a { transition: color 200ms ease; }
    .foot__zone a:hover, .foot__logo:hover { color: var(--bianco-puro); }
  }
</style>

<script>
  // link a nastro: un giro a ogni ingresso del mouse nel link, finito il giro si toglie la classe.
  // Delegato al documento: vale anche per i footer delle pagine caricate dal ClientRouter
  document.addEventListener('pointerover', e => {
    if (e.pointerType !== 'mouse') return;
    const link = (e.target as Element).closest('.foot__link');
    if (!link || link.contains(e.relatedTarget as Node | null) || link.classList.contains('is-run')) return;
    link.classList.add('is-run');
  });
  document.addEventListener('animationend', e => {
    if (e.animationName.endsWith('foot-nastro')) (e.target as Element).closest('.foot__link')?.classList.remove('is-run');
  });
</script>
